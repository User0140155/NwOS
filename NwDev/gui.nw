0A terminal_draw(1A theme, 1A mode) {
    1A c = accent(theme);
    1A x = 100;
    1A y = 80;
    1A w = 1080;
    1A h = 560;
    1A i = 0;
    1A n = 0;
    1A yy = 0;
    call win(theme, x, y, w, h, "Terminal");
    nw::rect(x + 22, y + 58, w - 44, h - 170, 0x0013181C);
    nw::rect(x + 22, y + 58, w - 44, 1, 0x00383F46);
    nw::text(x + 42, y + 74, c, "user@nwos");
    nw::text(x + 122, y + 74, 0x009AA4AE, nw::fs_path());
    nw::text(x + 42, y + 98, 0x00E8ECEF, "NwOS Terminal");
    yy = y + 126;
    if (mode == 0) {
        nw::text(x + 42, yy, 0x009AA4AE, "Type a command and press Enter.");
        nw::text(x + 42, yy + 24, 0x009AA4AE, "Type help to list available commands.");
        nw::text(x + 42, yy + 48, 0x009AA4AE, "Press Esc to close this window.");
    }
    if (mode == 1) {
        nw::text(x + 42, yy, c, "COMMAND");
        nw::text(x + 162, yy, c, "ACTION");
        nw::text(x + 42, yy + 22, 0x00D7DEE5, "help");
        nw::text(x + 162, yy + 22, 0x009AA4AE, "show this list");
        nw::text(x + 42, yy + 44, 0x00D7DEE5, "ver");
        nw::text(x + 162, yy + 44, 0x009AA4AE, "GUI version");
        nw::text(x + 42, yy + 66, 0x00D7DEE5, "time");
        nw::text(x + 162, yy + 66, 0x009AA4AE, "current time");
        nw::text(x + 42, yy + 88, 0x00D7DEE5, "ls");
        nw::text(x + 162, yy + 88, 0x009AA4AE, "list directory");
        nw::text(x + 42, yy + 110, 0x00D7DEE5, "pwd");
        nw::text(x + 162, yy + 110, 0x009AA4AE, "current path");
        nw::text(x + 42, yy + 132, 0x00D7DEE5, "up / root");
        nw::text(x + 162, yy + 132, 0x009AA4AE, "change directory");
        nw::text(x + 42, yy + 154, 0x00D7DEE5, "calc files editor settings");
        nw::text(x + 162, yy + 154, 0x009AA4AE, "open a desktop app");
        nw::text(x + 42, yy + 176, 0x00D7DEE5, "clear / exit");
        nw::text(x + 162, yy + 176, 0x009AA4AE, "clear output / close");
    }
    if (mode == 2) {
        nw::text(x + 42, yy, c, "DIRECTORY");
        nw::text(x + 162, yy, 0x009AA4AE, nw::fs_path());
        n = nw::fs_count();
        i = 0;
        while (i < n && i < 15) {
            if (nw::fs_type(i) == 1) {
                nw::text(x + 42, yy + 26 + i * 20, 0x002ECC9A, "DIR");
            } else {
                nw::text(x + 42, yy + 26 + i * 20, 0x009AA4AE, "FILE");
                nw::number(x + 100, yy + 26 + i * 20, 0x0088929A, nw::fs_size(i));
                nw::text(x + 156, yy + 26 + i * 20, 0x0088929A, "B");
            }
            nw::text(x + 212, yy + 26 + i * 20, 0x00D7DEE5, nw::fs_name(i));
            i = i + 1;
        }
        if (n == 0) nw::text(x + 42, yy + 26, 0x009AA4AE, "This directory is empty.");
    }
    if (mode == 3) {
        nw::text(x + 42, yy, c, "CURRENT PATH");
        nw::text(x + 42, yy + 28, 0x00D7DEE5, nw::fs_path());
    }
    if (mode == 4) {
        nw::text(x + 42, yy, c, "LOCAL TIME");
        call clock_big(x + 42, yy + 30, c);
    }
    if (mode == 5) {
        nw::text(x + 42, yy, c, "NWOS PLASMA 1.0");
        nw::text(x + 42, yy + 26, 0x009AA4AE, "NwC graphical desktop for NwOS");
        nw::text(x + 42, yy + 48, 0x009AA4AE, "1280 x 720 / backbuffer renderer");
    }
    if (mode == 7) {
        nw::text(x + 42, yy, 0x00E06C75, "Command not found.");
        nw::text(x + 42, yy + 26, 0x009AA4AE, "Type help to see valid commands.");
    }
    if (mode == 8) {
        nw::text(x + 42, yy, c, "Returned to terminal.");
    }
    nw::text(x + 42, y + h - 82, c, "user@nwos$");
    nw::text(x + 122, y + h - 82, 0x00E8ECEF, nw::buf_text());
    nw::rect(x + 122 + nw::buf_len() * 8, y + h - 82, 7, 10, c);
    nw::rect(x + 22, y + h - 54, w - 44, 1, 0x00383F46);
    nw::text(x + 42, y + h - 38, 0x009AA4AE, "Enter run   Backspace edit   Esc close   help lists commands");
}

1A terminal_app(1A theme) {
    1A mode = 0;
    1A key = 0;
    1A done = 0;
    while (done == 0) {
        call terminal_draw(theme, mode);
        nw::cursor(nw::mouse_x(), nw::mouse_y());
        nw::flush();
        key = nw::getkey();
        if (key == 255) done = 1;
        if (key == 256) {
            if (strcmp(nw::buf_text(), "help") == 0) mode = 1;
            else if (strcmp(nw::buf_text(), "ver") == 0) mode = 5;
            else if (strcmp(nw::buf_text(), "time") == 0) mode = 4;
            else if (strcmp(nw::buf_text(), "ls") == 0) mode = 2;
            else if (strcmp(nw::buf_text(), "pwd") == 0) mode = 3;
            else if (strcmp(nw::buf_text(), "up") == 0) {
                nw::fs_up();
                mode = 3;
            }
            else if (strcmp(nw::buf_text(), "root") == 0) {
                nw::fs_enter("/");
                mode = 3;
            }
            else if (strcmp(nw::buf_text(), "calc") == 0) {
                call calculator_app(theme);
                mode = 8;
            }
            else if (strcmp(nw::buf_text(), "files") == 0) {
                call file_manager_app(theme);
                mode = 8;
            }
            else if (strcmp(nw::buf_text(), "editor") == 0) {
                call editor_app("note.txt", theme);
                mode = 8;
            }
            else if (strcmp(nw::buf_text(), "settings") == 0) {
                theme = settings_app(theme);
                mode = 8;
            }
            else if (strcmp(nw::buf_text(), "clear") == 0) mode = 0;
            else if (strcmp(nw::buf_text(), "exit") == 0) done = 1;
            else mode = 7;
            nw::buf_clear();
        }
        if (key == 257) nw::buf_back();
        if (key >= 32 && key <= 126) {
            if (nw::buf_len() < 60) nw::buf_put(key);
        }
    }
    return theme;
}

0A calculator_draw(1A theme, 1A value, 1A error) {
    1A c = accent(theme);
    1A x = 460;
    1A y = 100;
    1A w = 360;
    1A h = 520;
    1A gx = x + 28;
    1A gy = y + 174;
    1A hit;
    1A i = 0;
    1A bx = 0;
    call win(theme, x, y, w, h, "Calculator");
    nw::rect(x + 24, y + 58, w - 48, 88, 0x0013181C);
    nw::rect(x + 24, y + 58, w - 48, 1, 0x00383F46);
    nw::text(x + 42, y + 74, 0x009AA4AE, "RESULT");
    if (error == 1) {
        nw::text(x + 42, y + 108, 0x00E06C75, "Error");
    } else {
        nw::number(x + 42, y + 108, 0x00F2F4F6, value);
    }
    hit = pad_hit(nw::mouse_x(), nw::mouse_y(), gx, gy);
    i = 0;
    while (i < 16) {
        bx = gx + (i - (i / 4) * 4) * 78;
        if (i == hit) {
            nw::rect(bx, gy + (i / 4) * 62, 70, 52, c);
        } else {
            nw::rect(bx, gy + (i / 4) * 62, 70, 52, 0x00313940);
        }
        i = i + 1;
    }
    nw::text(gx + 28, gy + 19, 0x00F2F4F6, "7");
    nw::text(gx + 106, gy + 19, 0x00F2F4F6, "8");
    nw::text(gx + 184, gy + 19, 0x00F2F4F6, "9");
    nw::text(gx + 262, gy + 19, 0x00F2F4F6, "/");
    nw::text(gx + 28, gy + 81, 0x00F2F4F6, "4");
    nw::text(gx + 106, gy + 81, 0x00F2F4F6, "5");
    nw::text(gx + 184, gy + 81, 0x00F2F4F6, "6");
    nw::text(gx + 262, gy + 81, 0x00F2F4F6, "*");
