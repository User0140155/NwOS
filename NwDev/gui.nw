#include <nwc.h>

1A accent(1A t) {
    if (t == 1) return 0x002ECC9A;
    if (t == 2) return 0x00B48EFF;
    if (t == 3) return 0x00F6B64A;
    return 0x003DAEE9;
}

1A accent_dim(1A t) {
    if (t == 1) return 0x00197A5D;
    if (t == 2) return 0x006B5599;
    if (t == 3) return 0x00946D2C;
    return 0x00256A8C;
}

1A inside(1A mx, 1A my, 1A x, 1A y, 1A w, 1A h) {
    if (mx >= x && mx <= x + w && my >= y && my <= y + h) return 1;
    return 0;
}

1A close_hit(1A mx, 1A my, 1A x, 1A y, 1A w) {
    return inside(mx, my, x + w - 38, y + 8, 26, 22);
}

0A box(1A x, 1A y, 1A w, 1A h, 1A fill, 1A ln) {
    nw::rect(x + 6, y + 8, w, h, 0x000C0F12);
    nw::rect(x - 1, y - 1, w + 2, h + 2, ln);
    nw::rect(x, y, w, h, fill);
}

0A seg(1A x, 1A y, 1A w, 1A h, 1A c) {
    if (w > 0 && h > 0) nw::rect(x, y, w, h, c);
}

0A big_digit(1A x, 1A y, 1A d, 1A c) {
    1A m = 0;
    1A t = 5;
    1A w = 34;
    1A h = 58;
    if (d == 0) m = 63;
    if (d == 1) m = 6;
    if (d == 2) m = 91;
    if (d == 3) m = 79;
    if (d == 4) m = 102;
    if (d == 5) m = 109;
    if (d == 6) m = 125;
    if (d == 7) m = 7;
    if (d == 8) m = 127;
    if (d == 9) m = 111;
    if (m >= 1) call seg(x + t, y, w - t * 2, t, c);
    if (m >= 2) call seg(x + w - t, y + t, t, h / 2 - t, c);
    if (m >= 4) call seg(x + w - t, y + h / 2, t, h / 2 - t, c);
    if (m >= 8) call seg(x + t, y + h - t, w - t * 2, t, c);
    if (m >= 16) call seg(x, y + h / 2, t, h / 2 - t, c);
    if (m >= 32) call seg(x, y + t, t, h / 2 - t, c);
    if (m >= 64) call seg(x + t, y + h / 2 - t / 2, w - t * 2, t, c);
}

0A clock_big(1A x, 1A y, 1A c) {
    1A hh = nw::hour();
    1A mm = nw::minute();
    call big_digit(x, y, hh / 10, c);
    call big_digit(x + 40, y, hh - (hh / 10) * 10, c);
    nw::rect(x + 82, y + 14, 6, 6, c);
    nw::rect(x + 82, y + 38, 6, 6, c);
    call big_digit(x + 96, y, mm / 10, c);
    call big_digit(x + 136, y, mm - (mm / 10) * 10, c);
}

0A clock_small(1A x, 1A y, 1A c) {
    1A hh = nw::hour();
    1A mm = nw::minute();
    if (hh < 10) nw::text(x, y, c, "0");
    nw::number(x + 8, y, c, hh);
    nw::text(x + 16, y, c, ":");
    if (mm < 10) nw::text(x + 24, y, c, "0");
    nw::number(x + 32, y, c, mm);
}

0A icon(1A k, 1A x, 1A y, 1A s, 1A c) {
    if (k == 0) {
        nw::rect(x, y, s, s, 0x00171D23);
        nw::rect(x, y, s, 2, c);
        nw::text(x + s / 4, y + s / 3 + 1, 0x00EEF2F5, ">_");
    }
    if (k == 1) {
        nw::rect(x, y + s / 5, s / 2, s / 4, c);
        nw::rect(x, y + s / 2, s, s / 2, c);
        nw::rect(x + 2, y + s / 2 + 2, s - 4, s / 2 - 4, 0x00F0C674);
    }
    if (k == 2) {
        nw::rect(x + s / 5, y, s * 3 / 5, s, 0x00E8ECEF);
        nw::rect(x + s / 3, y + s / 5, s / 3, 2, 0x005A6570);
        nw::rect(x + s / 3, y + s / 3, s / 3, 2, 0x005A6570);
        nw::rect(x + s / 3, y + s / 2, s / 4, 2, c);
    }
    if (k == 3) {
        nw::rect(x, y, s, s, c);
        nw::rect(x + s / 6, y + s / 6, s * 2 / 3, s / 4, 0x00151A1F);
        nw::rect(x + s / 6, y + s / 2, s / 4, s / 5, 0x00151A1F);
        nw::rect(x + s * 2 / 3, y + s / 2, s / 4, s / 5, 0x00151A1F);
    }
    if (k == 4) {
        nw::rect(x, y + s / 4, s, 2, c);
        nw::rect(x + s / 3, y + s / 4 - 4, 5, 10, 0x00EEF2F5);
        nw::rect(x, y + s / 2, s, 2, c);
        nw::rect(x + s * 2 / 3, y + s / 2 - 4, 5, 10, 0x00EEF2F5);
        nw::rect(x, y + s * 3 / 4, s, 2, c);
        nw::rect(x + s / 5, y + s * 3 / 4 - 4, 5, 10, 0x00EEF2F5);
    }
    if (k == 5) {
        nw::rect(x, y, s, s, 0x00171D23);
        nw::rect(x + 2, y + 2, s - 4, s - 4, 0x000E1216);
        nw::rect(x + s / 5, y + s * 2 / 3, s / 6, s / 5, c);
        nw::rect(x + s / 2 - s / 12, y + s / 2, s / 6, s / 3, c);
        nw::rect(x + s * 3 / 4 - s / 6, y + s / 3, s / 6, s / 2, c);
    }
}

0A dock_item(1A k, 1A x, 1A c) {
    1A y = 652;
    1A mx = nw::mouse_x();
    1A my = nw::mouse_y();
    1A hov = inside(mx, my, x, y, 58, 48);
    if (hov == 1) {
        nw::rect(x, y, 58, 48, 0x00323B43);
        nw::rect(x, y, 58, 2, c);
    } else {
        nw::rect(x, y, 58, 48, 0x00252B31);
    }
    call icon(k, x + 15, y + 5, 28, c);
    if (k == 0) nw::text(x + 15, y + 36, 0x00D7DEE5, "Term");
    if (k == 1) nw::text(x + 11, y + 36, 0x00D7DEE5, "Files");
    if (k == 2) nw::text(x + 15, y + 36, 0x00D7DEE5, "Edit");
    if (k == 3) nw::text(x + 15, y + 36, 0x00D7DEE5, "Calc");
    if (k == 4) nw::text(x + 19, y + 36, 0x00D7DEE5, "Set");
    if (k == 5) nw::text(x + 17, y + 36, 0x00D7DEE5, "Mon");
}

0A app_tile(1A k, 1A x, 1A y, 1A c) {
    1A mx = nw::mouse_x();
    1A my = nw::mouse_y();
    if (inside(mx, my, x, y, 168, 76) == 1) {
        nw::rect(x, y, 168, 76, 0x00313A42);
        nw::rect(x, y, 3, 76, c);
    } else {
        nw::rect(x, y, 168, 76, 0x00252B31);
    }
    call icon(k, x + 14, y + 22, 32, c);
    if (k == 0) {
        nw::text(x + 56, y + 24, 0x00EEF2F5, "Terminal");
        nw::text(x + 56, y + 44, 0x009AA4AE, "Command shell");
    }
    if (k == 1) {
        nw::text(x + 56, y + 24, 0x00EEF2F5, "File Manager");
        nw::text(x + 56, y + 44, 0x009AA4AE, "Browse storage");
    }
    if (k == 2) {
        nw::text(x + 56, y + 24, 0x00EEF2F5, "Text Editor");
        nw::text(x + 56, y + 44, 0x009AA4AE, "Edit plain text");
    }
    if (k == 3) {
        nw::text(x + 56, y + 24, 0x00EEF2F5, "Calculator");
        nw::text(x + 56, y + 44, 0x009AA4AE, "Quick arithmetic");
    }
    if (k == 4) {
        nw::text(x + 56, y + 24, 0x00EEF2F5, "Settings");
        nw::text(x + 56, y + 44, 0x009AA4AE, "Accent and style");
    }
    if (k == 5) {
        nw::text(x + 56, y + 24, 0x00EEF2F5, "System Monitor");
        nw::text(x + 56, y + 44, 0x009AA4AE, "CPU, GPU, memory");
    }
}

0A win(1A theme, 1A x, 1A y, 1A w, 1A h, str title) {
    str title2 = title;
    call draw_desktop(theme, 0);
    1A mx = nw::mouse_x();
    1A my = nw::mouse_y();
    nw::rect(x + 8, y + 10, w, h, 0x000C0F12);
    nw::rect(x - 1, y - 1, w + 2, h + 2, 0x00434A52);
    nw::rect(x, y, w, h, 0x0021262B);
    nw::rect(x, y, w, 38, 0x002A3036);
    nw::rect(x, y, w, 3, accent(theme));
    nw::text(x + 18, y + 15, 0x00F2F4F6, title2);
    if (inside(mx, my, x + w - 38, y + 8, 26, 22) == 1) {
        nw::rect(x + w - 38, y + 8, 26, 22, 0x00C74B4B);
    } else {
        nw::rect(x + w - 38, y + 8, 26, 22, 0x00343A41);
    }
    nw::text(x + w - 31, y + 12, 0x00FFFFFF, "X");
    nw::rect(x, y + 38, w, 1, 0x00383F46);
}

