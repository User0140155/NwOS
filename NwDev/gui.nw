        if (dragging == 1) {
            if (btn == 1) {
                next_x = mx - drag_dx;
                next_y = my - drag_dy;
                if (next_x < 0) next_x = 0;
                if (next_y < 0) next_y = 0;
                if (next_x > 1280 - w_w[drag_id]) next_x = 1280 - w_w[drag_id];
                if (next_y > 690 - w_h[drag_id]) next_y = 690 - w_h[drag_id];
                if (next_x != w_x[drag_id]) { w_x[drag_id] = next_x; dirty = 1; }
                if (next_y != w_y[drag_id]) { w_y[drag_id] = next_y; dirty = 1; }
            } else {
