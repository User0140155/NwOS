#include <nwc.h>

1A accent(1A t) {
    if (t == 1) return 0x004CB52C;
    if (t == 2) return 0x008F6BE0;
    if (t == 3) return 0x00F29A2E;
    return 0x002BA3E6;
}

1A accent_lt(1A t) {
    if (t == 1) return 0x00B4EE8A;
    if (t == 2) return 0x00D0BAFF;
    if (t == 3) return 0x00FFDDA0;
    return 0x008FDBFF;
}

1A accent_dim(1A t) {
    if (t == 1) return 0x002A6E1A;
    if (t == 2) return 0x004F33A0;
    if (t == 3) return 0x00A5560C;
    return 0x0014689E;
}

1A tone_top(1A k) {
    if (k == 1) return 0x009BE46A;
    if (k == 2) return 0x00C4A8FF;
    if (k == 3) return 0x00FFD07A;
    if (k == 4) return 0x00FFFFFF;
    if (k == 5) return 0x00FF9A84;
    if (k == 6) return 0x004A6C86;
    return 0x007FD6FF;
}

1A tone_bot(1A k) {
    if (k == 1) return 0x003E9E26;
    if (k == 2) return 0x007A52D0;
    if (k == 3) return 0x00E6841C;
    if (k == 4) return 0x00C4D9E8;
    if (k == 5) return 0x00D0301C;
    if (k == 6) return 0x000E2233;
    return 0x001C93DC;
}

1A tone_bd(1A k) {
    if (k == 1) return 0x002A6E1A;
    if (k == 2) return 0x004F33A0;
    if (k == 3) return 0x00A5560C;
    if (k == 4) return 0x007C9DB5;
    if (k == 5) return 0x008C1A0E;
    if (k == 6) return 0x0006121C;
    return 0x0014689E;
}

1A inside(1A mx, 1A my, 1A x, 1A y, 1A w, 1A h) {
    if (mx >= x && mx <= x + w && my >= y && my <= y + h) return 1;
    return 0;
}

1A close_hit(1A mx, 1A my, 1A x, 1A y, 1A w) {
    return inside(mx, my, x + w - 38, y + 8, 26, 22);
}

1A clampi(1A v, 1A lo, 1A hi) {
    if (v < lo) return lo;
    if (v > hi) return hi;
    return v;
}

// text with a soft drop shadow (for text on glass)
0A tx(1A x, 1A y, 1A c, str s) {
    str s2 = s;
    nw::text(x + 1, y + 1, 0x00083352, s2);
    nw::text(x, y, c, s2);
}

// glossy button: k = tone (0-3 accent themes, 4 silver, 5 red, 6 dark glass)
0A gbtn(1A x, 1A y, 1A w, 1A h, 1A k, 1A hot) {
    nw::rgrad(x, y, w, h, 7, tone_bd(k), tone_bd(k));
    nw::rgrad(x + 1, y + 1, w - 2, h - 2, 6, tone_top(k), tone_bot(k));
    nw::glass(x + 2, y + 2, w - 4, (h - 4) / 2, 5, 0x00FFFFFF, 105);
    if (hot == 1) nw::glass(x + 1, y + 1, w - 2, h - 2, 6, 0x00FFFFFF, 55);
}

// translucent dark-blue glass panel (desktop widgets, bars)
0A gpanel(1A x, 1A y, 1A w, 1A h, 1A r) {
    nw::glass(x - 1, y - 1, w + 2, h + 2, r + 1, 0x00FFFFFF, 95);
    nw::glass(x, y, w, h, r, 0x000A3A63, 150);
    nw::glass(x + 2, y + 2, w - 4, h / 2 - 2, r - 1, 0x00FFFFFF, 55);
}

0A clock_small(1A x, 1A y, 1A c) {
    1A hh = nw::hour();
    1A mm = nw::minute();
    if (hh < 10) {
        nw::text(x, y, c, "0");
        nw::number(x + 8, y, c, hh);
    } else {
        nw::number(x, y, c, hh);
    }
    nw::text(x + 16, y, c, ":");
    if (mm < 10) {
        nw::text(x + 24, y, c, "0");
        nw::number(x + 32, y, c, mm);
    } else {
        nw::number(x + 24, y, c, mm);
    }
}

// glossy app icons
0A icon(1A k, 1A x, 1A y, 1A s, 1A c) {
    if (k == 0) {
        nw::rgrad(x, y, s, s, 5, 0x004B6A82, 0x000B1B28);
        nw::text(x + s / 4, y + s / 3 + 3, 0x007CFFB0, ">_");
    }
    if (k == 1) {
        nw::rgrad(x, y + s / 5, s / 2, s / 4, 3, 0x00E9B84A, 0x00D79A22);
        nw::rgrad(x, y + s / 3, s, s * 2 / 3, 4, 0x00FFE9A0, 0x00F0B030);
    }
    if (k == 2) {
        nw::rgrad(x + s / 5, y, s * 3 / 5, s, 3, 0x00FFFFFF, 0x00B9D0E0);
        nw::rect(x + s / 3, y + s / 3, s / 3, 2, c);
        nw::rect(x + s / 3, y + s / 2, s / 3, 2, c);
        nw::rect(x + s / 3, y + s * 2 / 3, s / 4, 2, c);
    }
    if (k == 3) {
        nw::rgrad(x, y, s, s, 5, 0x00EAF4FB, 0x009DBFD6);
        nw::rgrad(x + s / 6, y + s / 6, s * 2 / 3, s / 4, 2, 0x00355B78, 0x00163048);
        nw::rgrad(x + s / 6, y + s / 2, s * 2 / 3, s / 4, 2, 0x00FFFFFF, c);
    }
    if (k == 4) {
        nw::rgrad(x, y, s, s, 5, 0x00FFFFFF, 0x00CFE2EF);
        nw::rect(x + 3, y + s / 3, s - 6, 2, 0x008FB0C8);
        nw::rect(x + 3, y + s * 2 / 3, s - 6, 2, 0x008FB0C8);
        nw::orb(x + s / 3, y + s / 3 + 1, 4, c);
        nw::orb(x + s * 2 / 3, y + s * 2 / 3 + 1, 4, c);
    }
    if (k == 5) {
        nw::rgrad(x, y, s, s, 5, 0x002D4A60, 0x000C1B27);
        nw::rgrad(x + s / 5, y + s / 2, s / 5, s / 3, 1, 0x00C9F0FF, c);
        nw::rgrad(x + s * 3 / 5, y + s / 4, s / 5, s * 7 / 12, 1, 0x00C9F0FF, c);
    }
    if (k == 6) {
        nw::rgrad(x, y, s, s, 5, 0x00FFFFFF, 0x00C7E0F0);
        nw::rgrad(x + s / 8, y + s / 8, s * 3 / 4, s / 4, 3, c, c);
        nw::text(x + s / 6, y + s / 2 + 1, 0x000E3A5C, "Ab");
    }
    nw::glass(x + 1, y + 1, s - 2, s / 2 - 1, 4, 0x00FFFFFF, 60);
}


