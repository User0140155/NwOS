    1A cur_sec = 0;


    w_open[1] = 1; w_x[1] = 156; w_y[1] = 86;  w_w[1] = 438; w_h[1] = 326;
    w_open[2] = 0; w_x[2] = 244; w_y[2] = 112; w_w[2] = 360; w_h[2] = 340;
    w_open[3] = 0; w_x[3] = 300; w_y[3] = 150; w_w[3] = 360; w_h[3] = 330;
    w_open[4] = 0; w_x[4] = 220; w_y[4] = 120; w_w[4] = 380; w_h[4] = 320;
    w_z[0] = 1; w_z[1] = 2; w_z[2] = 3; w_z[3] = 4;
    while (running == 1) {

        dirty = 0;

        if (nw::second() != mon_sec) {
            mon_sec = nw::second();
            cur_hour = nw::hour();
            cur_min = nw::minute();
            cur_sec = mon_sec;
            mon_cpu = nw::cpu_load();
            mon_gpu = nw::gpu_load();
            dirty = 1;
        }

        mx = nw::mouse_x();
        my = nw::mouse_y();
        btn = nw::mouse_buttons();

        if (mx != lastx) dirty = 1;
        if (my != lasty) dirty = 1;
        if (btn != lastbtn) dirty = 1;

        if (btn == 1) {
            if (lastbtn == 0) {
                menu_before = start_open;
                in_menu = 0;

                if (start_open == 1) {
                    if (mx >= 7 && mx <= 235 && my >= 425 && my <= 691) {
                        in_menu = 1;
                        if (mx >= 41 && mx <= 227) {
                            if (my >= 606 && my <= 626) { running = 0; }
                            if (my >= 630 && my <= 650) { nw::poweroff(); }
                            if (my >= 654 && my <= 674) { nw::reboot(); }
                        }
                    }
                }

                hit = 0;
                if (in_menu == 0) {
                    zi = 3;
                    while (zi >= 0) {
                        wid = w_z[zi];
                        if (w_open[wid] == 1 &&
                            mx >= w_x[wid] && mx < w_x[wid] + w_w[wid] &&
                            my >= w_y[wid] && my < w_y[wid] + w_h[wid]) {
                            hit = wid;
                            zi = -1;
                        } else {
                            zi = zi - 1;
                        }
                    }
                }

                open_id = 0;
                if (hit == 0 && in_menu == 0) {
                    if (mx >= 24 && mx <= 84 && my >= 34 && my <= 100) open_id = 1;
                    if (mx >= 30 && mx <= 84 && my >= 130 && my <= 188) open_id = 2;
                    if (mx >= 30 && mx <= 84 && my >= 224 && my <= 282) open_id = 3;
                    if (mx >= 24 && mx <= 84 && my >= 316 && my <= 382) open_id = 4;

                    if (open_id != 0) {
                        if (w_open[open_id] == 0) {
                            w_open[open_id] = 1;
                            if (open_id == 1) { w_x[1] = 156; w_y[1] = 86;  w_w[1] = 438; w_h[1] = 326; }
                            if (open_id == 2) { w_x[2] = 244; w_y[2] = 112; w_w[2] = 360; w_h[2] = 340; }
                            if (open_id == 3) { w_x[3] = 300; w_y[3] = 150; w_w[3] = 360; w_h[3] = 330; }
                            if (open_id == 4) { w_x[4] = 220; w_y[4] = 120; w_w[4] = 380; w_h[4] = 320; }
                            dirty = 1;
                        }
                        raise_id = open_id;
                    }
                }

                if (hit != 0) {
                    wid = hit;
                    raise_id = hit;
                    if (mx >= w_x[wid] + w_w[wid] - 20 &&
                        mx <= w_x[wid] + w_w[wid] - 6 &&
                        my >= w_y[wid] + 7 && my <= w_y[wid] + 20) {
                        w_open[wid] = 0;
                        dirty = 1;
                    } else {
                        wx = w_x[wid]; wy = w_y[wid]; ww = w_w[wid]; wh = w_h[wid];
                        wby = wy + 28; wbh = wh - 32;
                        dragging = 0; resizing = 0;
                        rz_left = 0; rz_right = 0; rz_top = 0; rz_bottom = 0;

                        if (mx >= wx && mx <= wx + 6) { rz_left = 1; resizing = 1; }
                        if (mx >= wx + ww - 6 && mx <= wx + ww) { rz_right = 1; resizing = 1; }
                        if (my >= wy && my <= wy + 6) { rz_top = 1; resizing = 1; }
                        if (my >= wy + wh - 6 && my <= wy + wh) { rz_bottom = 1; resizing = 1; }
                        if (resizing == 1) rz_id = wid;

                        if (resizing == 0 &&
                            mx >= wx + 3 && mx <= wx + ww - 3 &&
                            my >= wy + 3 && my <= wy + 23) {
                            dragging = 1; drag_id = wid;
                            drag_dx = mx - wx; drag_dy = my - wy;
                        }

                        if (resizing == 0 && dragging == 0) {
                            if (wid == 1 && my > wby && my < wy + wh - 20) {
                    if (my >= wby + 24 && my <= wby + 42) {
                        if (mx >= wx + 20 && mx <= wx + 74) {
                            call file_prompt_new();
                            dirty = 1;
                        }
                        if (mx >= wx + 78 && mx <= wx + 132 && fm_sel >= 0) {
                            if (nw::fs_type(fm_sel) == 0) {
                                fm_name_s = nw::fs_name(fm_sel);
                                call file_editor(fm_name_s);
                                dirty = 1;
                            }
                        }
                        if (mx >= wx + 136 && mx <= wx + 190 && fm_sel >= 0) {
                            fm_name_s = nw::fs_name(fm_sel);
                            call file_delete_confirm(fm_name_s);
                            fm_sel = -1;
                            dirty = 1;
                        }
                        if (mx >= wx + 194 && mx <= wx + 256) {
                            call dir_prompt_new();
                            dirty = 1;
                        }
                    }
                    if (mx >= wx + 20 && mx <= wx + ww - 20) {
                        if (my >= wby + 50 && my < wby + 66) {
                            nw::fs_up();
                            fm_sel = -1;
                            dirty = 1;
                        }
                    }
                    fm_i = 0;
                    fm_count = nw::fs_count();
                    while (fm_i < fm_count) {
                        if (fm_i > 10) break;
                        if (my >= wby + 70 + fm_i * 18 &&
                            my <  wby + 70 + fm_i * 18 + 18 &&
                            mx >= (wx + 20) && mx <= (wx + ww - 20)) {

                            fm_type = nw::fs_type(fm_i);
                            if (fm_type == 1) {
                                /* enter directory */
                                nw::fs_enter(nw::fs_name(fm_i));
                                fm_sel = -1;
                            } else {
                                fm_sel = fm_i;
                            }
                            dirty = 1;
                        }
                        fm_i = fm_i + 1;
                    }
                            }
                            if (wid == 2) {
                    grid_x = wx + 60;
                    grid_y = wby + 46;

                    if (mx >= (wx + ww - 70) && mx <= (wx + ww - 20) &&
                        my >= (wby + 6) && my <= (wby + 24)) {
                        ms_started = 0;
                        ms_state = 0;
                        dirty = 1;
                    }

                    if (mx >= grid_x && mx < (grid_x + 9 * cell_sz) &&
                        my >= grid_y && my < (grid_y + 9 * cell_sz)) {

                        ms_cx = (mx - grid_x) / cell_sz;
                        ms_cy = (my - grid_y) / cell_sz;
                        ms_i  = ms_cy * 9 + ms_cx;

                        if (ms_started == 0) {
                            ms_seed = mx + my * 31 + 12345;
                            ms_started = 1;

                            ms_j = 0;
                            while (ms_j < 81) {
                                ms_mines[ms_j]    = 0;
                                ms_revealed[ms_j] = 0;
                                ms_flagged[ms_j]  = 0;
                                ms_j = ms_j + 1;
                            }
                            ms_state = 0;
                            ms_opened = 0;
                            ms_flags  = 0;

                            ms_j = 0;
                            while (ms_j < 10) {
                                ms_seed = ms_seed * 1103 + 12345;
                                ms_seed = ms_seed - ((ms_seed / 65536) * 65536);
                                ms_r    = ms_seed - ((ms_seed / 81) * 81);
                                if (ms_mines[ms_r] == 0) {
                                    ms_mines[ms_r] = 1;
                                    ms_j = ms_j + 1;
                                }
                            }

                            if (ms_mines[ms_i] == 1) {
                                ms_mines[ms_i] = 0;
                                ms_j = 0;
                                while (ms_j < 81) {
                                    if (ms_mines[ms_j] == 0) {
                                        ms_mines[ms_j] = 1;
                                        ms_j = 81;
                                    } else {
                                        ms_j = ms_j + 1;
                                    }
                                }
                            }

                            ms_j = 0;
                            while (ms_j < 81) {
                                ms_cx = ms_j - ((ms_j / 9) * 9);
                                ms_cy = ms_j / 9;
                                ms_cnt = 0;
                                ms_ny = ms_cy - 1;
                                while (ms_ny <= ms_cy + 1) {
                                    ms_nx = ms_cx - 1;
                                    while (ms_nx <= ms_cx + 1) {
                                        if (ms_nx >= 0 && ms_nx < 9 &&
                                            ms_ny >= 0 && ms_ny < 9) {
                                            if (ms_mines[ms_ny * 9 + ms_nx] == 1) {
                                                ms_cnt = ms_cnt + 1;
                                            }
                                        }
                                        ms_nx = ms_nx + 1;
                                    }
                                    ms_ny = ms_ny + 1;
                                }
                                ms_adjacent[ms_j] = ms_cnt;
                                ms_j = ms_j + 1;
                            }
                        }

                        if (ms_state == 0 && ms_revealed[ms_i] == 0 && ms_flagged[ms_i] == 0) {
                            if (ms_mines[ms_i] == 1) {
                                ms_state = 2;
                                ms_revealed[ms_i] = 1;
                            } else {
                                ms_revealed[ms_i] = 1;
                                ms_opened = ms_opened + 1;

                                ms_changed = 1;
                                while (ms_changed == 1) {
                                    ms_changed = 0;
                                    ms_j = 0;
                                    while (ms_j < 81) {
                                        if (ms_revealed[ms_j] == 1 &&
                                            ms_mines[ms_j] == 0 &&
                                            ms_adjacent[ms_j] == 0) {
                                            ms_cx = ms_j - ((ms_j / 9) * 9);
                                            ms_cy = ms_j / 9;
                                            ms_ny = ms_cy - 1;
                                            while (ms_ny <= ms_cy + 1) {
                                                ms_nx = ms_cx - 1;
                                                while (ms_nx <= ms_cx + 1) {
                                                    if (ms_nx >= 0 && ms_nx < 9 &&
                                                        ms_ny >= 0 && ms_ny < 9) {
                                                        if (ms_revealed[ms_ny * 9 + ms_nx] == 0 &&
                                                            ms_flagged[ms_ny * 9 + ms_nx] == 0) {
                                                            ms_revealed[ms_ny * 9 + ms_nx] = 1;
                                                            ms_opened = ms_opened + 1;
                                                            ms_changed = 1;
                                                        }
                                                    }
                                                    ms_nx = ms_nx + 1;
                                                }
                                                ms_ny = ms_ny + 1;
                                            }
                                        }
                                        ms_j = ms_j + 1;
                                    }
                                }

                                if (ms_opened == 71) ms_state = 1;
                            }
                        }
                        dirty = 1;
                    }
                            }
                            if (wid == 3) {
                    calc_left = wx + 30;
                    calc_top  = wby + 64;

                    if (mx >= calc_left && mx < (calc_left + 4 * calc_bw + 3 * calc_gap) &&
                        my >= calc_top && my < (calc_top + 4 * calc_bh + 3 * calc_gap)) {
                        calc_col = (mx - calc_left) / (calc_bw + calc_gap);
                        calc_row = (my - calc_top) / (calc_bh + calc_gap);
                        calc_key = 99;

                        if (calc_row == 0) {
                            if (calc_col == 0) calc_key = 6;
                            if (calc_col == 1) { calc_key = 0; calc_digit = 0; }
                            if (calc_col == 2) calc_key = 4;
                            if (calc_col == 3) calc_key = 3;
                        } else if (calc_col < 3) {
                            calc_key = 0;
                            calc_digit = 10 - calc_row * 3 + calc_col;
                        } else {
                            if (calc_row == 1) calc_key = 2;
                            if (calc_row == 2) calc_key = 1;
                            if (calc_row == 3) calc_key = 5;
                        }

                        if (calc_key == 0) {
                            if (calc_fresh == 1) {
                                calc_val = calc_digit;
                                calc_fresh = 0;
                            } else {
                                calc_val = calc_val * 10 + calc_digit;
                            }
                        } else if (calc_key == 6) {
                            calc_val = 0;
                            calc_acc = 0;
                            calc_op = 0;
                            calc_fresh = 1;
                        } else if (calc_key == 5) {
                            if (calc_op != 0) {
                                calc_val = calc_apply(calc_acc, calc_val, calc_op);
                                calc_op = 0;
                                calc_fresh = 1;
                            }
                        } else if (calc_key < 5) {
                            if (calc_op != 0 && calc_fresh == 0)
                                calc_acc = calc_apply(calc_acc, calc_val, calc_op);
                            else if (calc_op == 0)
                                calc_acc = calc_val;
                            calc_op = calc_key;
                            calc_val = calc_acc;
                            calc_fresh = 1;
                        }
                        dirty = 1;
                    }
                            }
                            if (wid == 4) {
                    if (mx >= wx + ww - 70 && mx <= wx + ww - 48 &&
                        my >= wby + 236 && my <= wby + 256) {
                        nw::tz_set(nw::tz_get() - 1);
                        cur_hour = nw::hour();
                        cur_min = nw::minute();
                        cur_sec = nw::second();
                        dirty = 1;
                    }
                    if (mx >= wx + ww - 40 && mx <= wx + ww - 18 &&
                        my >= wby + 236 && my <= wby + 256) {
                        nw::tz_set(nw::tz_get() + 1);
                        cur_hour = nw::hour();
                        cur_min = nw::minute();
                        cur_sec = nw::second();
                        dirty = 1;
                    }
                            }
                        }
                    }
                }

                if (raise_id != 0) {
                    focus = raise_id;
                    if (w_z[3] != raise_id) {
                        zi = 0;
                        while (zi < 3) {
                            if (w_z[zi] == raise_id) {
                                w_z[zi] = w_z[zi + 1];
                                w_z[zi + 1] = raise_id;
                            }
                            zi = zi + 1;
                        }
                    }
                }

                if (hit == 0 && open_id == 0 && in_menu == 0 &&
                    mx >= 4 && mx <= 92 && my >= 695 && my <= 717) {
                    if (start_open == 1) start_open = 0;
                    else start_open = 1;
                    dirty = 1;
                }

                if (menu_before == 1 && in_menu == 0) {
                    start_open = 0;
                    dirty = 1;
                }
            }
        }

        if (btn == 2) {
            if (lastbtn != 2 && focus == 2 && w_open[2] == 1 &&
                dragging == 0 && resizing == 0 && ms_started == 1 && ms_state == 0) {
                wx = w_x[2]; wy = w_y[2]; ww = w_w[2]; wh = w_h[2];
                wby = wy + 28;
                grid_x = wx + 60;
                grid_y = wby + 46;
                if (mx >= grid_x && mx < grid_x + 9 * cell_sz &&
                    my >= grid_y && my < grid_y + 9 * cell_sz) {
                    ms_cx = (mx - grid_x) / cell_sz;
                    ms_cy = (my - grid_y) / cell_sz;
                    ms_i  = ms_cy * 9 + ms_cx;
                    if (ms_revealed[ms_i] == 0) {
                        if (ms_flagged[ms_i] == 1) {
                            ms_flagged[ms_i] = 0;
                            ms_flags = ms_flags - 1;
                        } else {
                            ms_flagged[ms_i] = 1;
                            ms_flags = ms_flags + 1;
                        }
                        dirty = 1;
                    }
                    dirty = 1;
                }
            }
