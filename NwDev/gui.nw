    if (inside(nw::mouse_x(), nw::mouse_y(), x, y, 216, 42) == 1) {
        nw::rgrad(x, y, 216, 42, 6, 0x00E8F8FF, 0x009FD8F6);
    }
    call icon(k, x + 8, y + 7, 28, c);
    nw::text(x + 50, y + 17, 0x000E3A5C, l2);
}

0A mlink(1A x, 1A y, str label) {
