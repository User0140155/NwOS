#include <nwc.h>

1A main() {
    clear_screen();

    1A running        = 1;
    1A start_open     = 0;
    1A window_open    = 1;
    1A win_x          = 156;
    1A win_y          = 86;
    1A win_w          = 438;
    1A win_h          = 326;

    1A tab            = 0;
    1A mx             = 640;
    1A my             = 360;
    1A btn            = 0;
    1A lastbtn        = 0;
    1A lastx          = 0;
    1A lasty          = 0;
    1A dirty          = 1;
    1A in_menu        = 0;
    1A menu_before    = 0;

    1A dragging       = 0;
    1A drag_dx        = 0;
    1A drag_dy        = 0;
    1A next_x         = 0;
    1A next_y         = 0;

    1A resizing       = 0;
    1A rz_left        = 0;
    1A rz_right       = 0;
    1A rz_top         = 0;
    1A rz_bottom      = 0;
    1A new_x          = 0;
    1A new_y          = 0;
    1A new_w          = 0;
    1A new_h          = 0;

    1A fm_count       = 0;
    1A fm_i           = 0;
    1A fm_type        = 0;
    1A fm_size        = 0;
    1A fm_sel         = -1;
    str fm_path_s;
    str fm_name_s;
    str fm_size_s;

    1A ms_started     = 0;
    1A ms_state       = 0;
    1A ms_mines[81];
    1A ms_revealed[81];
    1A ms_flagged[81];
    1A ms_adjacent[81];
    1A ms_seed        = 0;
    1A ms_i           = 0;
    1A ms_j           = 0;
    1A ms_cx          = 0;
    1A ms_cy          = 0;
    1A ms_nx          = 0;
    1A ms_ny          = 0;
    1A ms_cnt         = 0;
    1A ms_opened      = 0;
    1A ms_flags       = 0;
    1A ms_r           = 0;


    1A body_y = 0;
    1A body_h = 0;
    1A grid_x = 0;
    1A grid_y = 0;
    1A cell_sz = 18;

    while (running == 1) {

        dirty = 0;

        mx = nw::mouse_x();
        my = nw::mouse_y();
        btn = nw::mouse_buttons();

        if (mx != lastx) dirty = 1;
        if (my != lasty) dirty = 1;
        if (btn != lastbtn) dirty = 1;

        body_y = win_y + 46;
        body_h = win_h - 66;

        if (btn == 1) {
            if (lastbtn == 0) {
                menu_before = start_open;
                in_menu     = 0;

                if (start_open == 1) {
                    if (mx >= 7 && mx <= 235 && my >= 425 && my <= 691) in_menu = 1;

                    if (mx >= 41 && mx <= 227) {
                        if (my >= 606 && my <= 626) { running = 0; }
                        if (my >= 630 && my <= 650) { nw::poweroff(); }
                        if (my >= 654 && my <= 674) { nw::reboot(); }
                    }
                }

                if (window_open == 1) {
                    if (mx >= (win_x + win_w - 20) && mx <= (win_x + win_w - 6) &&
                        my >= (win_y + 7) && my <= (win_y + 20)) {
                        window_open = 0;
                        dragging = 0; resizing = 0;
                        dirty = 1;
                    }
                }

                if (window_open == 1) {
                    dragging = 0; resizing = 0;
                    rz_left = 0; rz_right = 0; rz_top = 0; rz_bottom = 0;

                    if (mx >= (win_x - 5) && mx <= (win_x + 5) &&
                        my >= (win_y - 5) && my <= (win_y + win_h + 5)) {
                        rz_left = 1; resizing = 1;
                    }
                    if (mx >= (win_x + win_w - 5) && mx <= (win_x + win_w + 5) &&
                        my >= (win_y - 5) && my <= (win_y + win_h + 5)) {
                        rz_right = 1; resizing = 1;
                    }
                    if (my >= (win_y - 5) && my <= (win_y + 5) &&
                        mx >= (win_x - 5) && mx <= (win_x + win_w + 5)) {
                        rz_top = 1; resizing = 1;
                    }
                    if (my >= (win_y + win_h - 5) && my <= (win_y + win_h + 5) &&
                        mx >= (win_x - 5) && mx <= (win_x + win_w + 5)) {
                        rz_bottom = 1; resizing = 1;
                    }

                    if (resizing == 0 &&
                        mx >= (win_x + 3) && mx <= (win_x + win_w - 3) &&
                        my >= (win_y + 3) && my <= (win_y + 23)) {
                        dragging = 1;
                        drag_dx = mx - win_x;
                        drag_dy = my - win_y;
                    }
                }

                if (window_open == 1 && resizing == 0 && dragging == 0) {
                    if (my >= (win_y + 22) && my <= (win_y + 44)) {
                        if (mx >= (win_x + 10) && mx <  (win_x + 100)) { tab = 0; dirty = 1; }
                        if (mx >= (win_x + 100) && mx < (win_x + 190)) { tab = 1; dirty = 1; }
                        if (mx >= (win_x + 190) && mx < (win_x + 280)) { tab = 2; dirty = 1; }
                    }
                }

                if (window_open == 1 && tab == 1 && dragging == 0 && resizing == 0 &&
                    my > body_y && my < (win_y + win_h - 20)) {

                    if (mx >= (win_x + 20) && mx <= (win_x + win_w - 20)) {
                        if (my >= body_y + 4 && my < body_y + 4 + 18) {
                            nw::fs_up();
                            dirty = 1;
                        }
                    }
                    fm_i = 0;
                    fm_count = nw::fs_count();
                    while (fm_i < fm_count) {
                        if (fm_i > 12) break;
                        if (my >= body_y + 30 + fm_i * 18 &&
                            my <  body_y + 30 + fm_i * 18 + 18 &&
                            mx >= (win_x + 20) && mx <= (win_x + win_w - 20)) {

                            fm_type = nw::fs_type(fm_i);
                            if (fm_type == 1) {
                                /* enter directory */
                                nw::fs_enter(nw::fs_name(fm_i));
                            } else {
                                fm_sel = fm_i;
                            }
                            dirty = 1;
                        }
                        fm_i = fm_i + 1;
                    }
                }

                if (window_open == 1 && tab == 2 && dragging == 0 && resizing == 0) {
                    grid_x = win_x + 60;
                    grid_y = body_y + 40;

                    if (mx >= grid_x && mx < (grid_x + 9 * cell_sz) &&
                        my >= grid_y && my < (grid_y + 9 * cell_sz)) {

                        ms_cx = (mx - grid_x) / cell_sz;
                        ms_cy = (my - grid_y) / cell_sz;
                        ms_i  = ms_cy * 9 + ms_cx;

                        if (ms_started == 0) {
                            /* seed from mouse */
                            ms_seed = mx + my * 31 + 12345;
                            ms_started = 1;

                            ms_j = 0;
                            while (ms_j < 81) {
                                ms_mines[ms_j]    = 0;
                                ms_revealed[ms_j] = 0;
                                ms_flagged[ms_j]  = 0;
                                ms_j = ms_j + 1;
                            }
                            ms_state = 0;
                            ms_opened = 0;
                            ms_flags  = 0;

                            ms_j = 0;
                            while (ms_j < 10) {
                                ms_seed = ms_seed * 1103515245 + 12345;
                                ms_r    = ms_seed / 65536;
                                ms_r    = ms_r - ((ms_r / 81) * 81);
                                if (ms_mines[ms_r] == 0) {
                                    ms_mines[ms_r] = 1;
                                    ms_j = ms_j + 1;
                                }
                            }

                            ms_j = 0;
                            while (ms_j < 81) {
                                ms_cx = ms_j - ((ms_j / 9) * 9);
                                ms_cy = ms_j / 9;
                                ms_cnt = 0;
                                ms_ny = ms_cy - 1;
                                while (ms_ny <= ms_cy + 1) {
                                    ms_nx = ms_cx - 1;
                                    while (ms_nx <= ms_cx + 1) {
                                        if (ms_nx >= 0 && ms_nx < 9 &&
                                            ms_ny >= 0 && ms_ny < 9) {
                                            if (ms_mines[ms_ny * 9 + ms_nx] == 1) {
                                                ms_cnt = ms_cnt + 1;
                                            }
                                        }
                                        ms_nx = ms_nx + 1;
                                    }
                                    ms_ny = ms_ny + 1;
                                }
                                ms_adjacent[ms_j] = ms_cnt;
                                ms_j = ms_j + 1;
                            }
                        }

                        if (ms_state == 0 && ms_revealed[ms_i] == 0 && ms_flagged[ms_i] == 0) {
                            if (ms_mines[ms_i] == 1) {
                                ms_state = 2;
                                ms_revealed[ms_i] = 1;
                            } else {
                                ms_revealed[ms_i] = 1;
                                ms_opened = ms_opened + 1;
                                if (ms_opened == 71) ms_state = 1;
                            }
                        }
                        dirty = 1;
                    }
                }

                if (mx >= 24 && mx <= 84 && my >= 34 && my <= 100) {
                    window_open = 1;
                    tab = 1;
                    dirty = 1;
                }

                if (mx >= 30 && mx <= 84 && my >= 130 && my <= 188) {
                    window_open = 1;
                    tab = 2;
                    dirty = 1;
                }

                if (mx >= 4 && mx <= 92 && my >= 695 && my <= 717) {
                    if (start_open == 1) start_open = 0;
                    else start_open = 1;
                    dirty = 1;
                }

                if (menu_before == 1 && in_menu == 0) {
                    start_open = 0;
                    dirty = 1;
                }
            }
        }

        if (btn == 2) {
            if (lastbtn != 2 && window_open == 1 && tab == 2 &&
                dragging == 0 && resizing == 0 && ms_started == 1 && ms_state == 0) {
                grid_x = win_x + 60;
                grid_y = body_y + 40;
                if (mx >= grid_x && mx < (grid_x + 9 * cell_sz) &&
                    my >= grid_y && my < (grid_y + 9 * cell_sz)) {
                    ms_cx = (mx - grid_x) / cell_sz;
                    ms_cy = (my - grid_y) / cell_sz;
                    ms_i  = ms_cy * 9 + ms_cx;
                    if (ms_revealed[ms_i] == 0) {
                        if (ms_flagged[ms_i] == 1) {
                            ms_flagged[ms_i] = 0;
                            ms_flags = ms_flags - 1;
                        } else {
                            ms_flagged[ms_i] = 1;
                            ms_flags = ms_flags + 1;
                        }
                        dirty = 1;
                    }
                }
            }
        }

        if (dragging == 1) {
            if (btn == 1) {
                next_x = mx - drag_dx;
                next_y = my - drag_dy;
                if (next_x < 0) next_x = 0;
                if (next_y < 0) next_y = 0;
                if (next_x > (1280 - win_w)) next_x = 1280 - win_w;
                if (next_y > (690 - win_h)) next_y = 690 - win_h;
                if (next_x != win_x) { win_x = next_x; dirty = 1; }
                if (next_y != win_y) { win_y = next_y; dirty = 1; }
            } else {
                dragging = 0;
            }
        }

        if (resizing == 1) {
            if (btn == 1) {
                new_x = win_x;  new_y = win_y;
                new_w = win_w;  new_h = win_h;

                if (rz_right == 1)  new_w = mx - win_x;
                if (rz_bottom == 1) new_h = my - win_y;
                if (rz_left == 1)  { new_w = (win_x + win_w) - mx; new_x = mx; }
                if (rz_top == 1)   { new_h = (win_y + win_h) - my; new_y = my; }

                if (new_w < 360) {
                    if (rz_left == 1) new_x = (win_x + win_w) - 360;
                    new_w = 360;
                }
                if (new_h < 300) {
                    if (rz_top == 1) new_y = (win_y + win_h) - 300;
                    new_h = 300;
                }
                if (new_x < 0) { new_w = new_w + new_x; new_x = 0; }
                if (new_y < 0) { new_h = new_h + new_y; new_y = 0; }
                if ((new_x + new_w) > 1280) new_w = 1280 - new_x;
                if ((new_y + new_h) > 690) new_h = 690 - new_y;

                if (new_x != win_x) { win_x = new_x; dirty = 1; }
                if (new_y != win_y) { win_y = new_y; dirty = 1; }
                if (new_w != win_w) { win_w = new_w; dirty = 1; }
                if (new_h != win_h) { win_h = new_h; dirty = 1; }
            } else {
                resizing = 0;
                rz_left = 0; rz_right = 0; rz_top = 0; rz_bottom = 0;
            }
        }

        if (dirty == 1) {

            nw::wallpaper();

            nw::rect(30, 34, 54, 44, 0x00E0E0E0);
            nw::rect(36, 40, 42, 28, 0x00008080);
            nw::rect(28, 78, 58, 6, 0x00C0C0C0);
            nw::draw!TEXT << x=24,y=92 !COLOR=WHITE << "My Computer";

            nw::rect(30, 130, 54, 44, 0x00E0E0E0);
            nw::rect(38, 138, 38, 28, 0x00A00000);
            nw::rect(44, 144, 26, 3, 0x00000000);
            nw::rect(44, 151, 26, 3, 0x00000000);
            nw::rect(44, 158, 18, 3, 0x00000000);
            nw::draw!TEXT << x=22,y=188 !COLOR=WHITE << "Minesweeper";

            if (window_open == 1) {
                nw::rect(win_x + 7, win_y + 7, win_w, win_h, 0x00404040);
                nw::window(win_x, win_y, win_w, win_h, 0x000080, "NwOS 26: GUI");

                if (tab == 0) nw::rect(win_x + 10,  win_y + 22, 90, 22, 0x00E0E0E0);
                else          nw::rect(win_x + 10,  win_y + 22, 90, 22, 0x00C0C0C0);
                nw::draw!TEXT << x=win_x + 18,y=win_y + 26 !COLOR=BLACK << "Welcome";

                if (tab == 1) nw::rect(win_x + 100, win_y + 22, 90, 22, 0x00E0E0E0);
                else          nw::rect(win_x + 100, win_y + 22, 90, 22, 0x00C0C0C0);
                nw::draw!TEXT << x=win_x + 116,y=win_y + 26 !COLOR=BLACK << "Files";

                if (tab == 2) nw::rect(win_x + 190, win_y + 22, 90, 22, 0x00E0E0E0);
                else          nw::rect(win_x + 190, win_y + 22, 90, 22, 0x00C0C0C0);
                nw::draw!TEXT << x=win_x + 206,y=win_y + 26 !COLOR=BLACK << "Mine";

                nw::rect(win_x + 10, win_y + 44, win_w - 20, 2, 0x00808080);
                nw::rect(win_x + 10, win_y + 45, win_w - 20, 1, 0x00FFFFFF);

                body_y = win_y + 46;
                body_h = win_h - 66;

                if (tab == 0) {
                    nw::text(win_x + 20, body_y + 10, 0x000000, "Welcome to NwOS 26: GUI");
                    nw::rect(win_x + 18, body_y + 30, win_w - 42, 2, 0x00808080);
                    nw::rect(win_x + 18, body_y + 31, win_w - 42, 1, 0x00FFFFFF);

                    nw::rect(win_x + 22, body_y + 46, 62, 54, 0x00FFFFFF);
                    nw::rect(win_x + 25, body_y + 49, 56, 42, 0x00008080);

                    nw::text(win_x + 108, body_y + 52, 0x000000, "System is ready.");
                    nw::text(win_x + 108, body_y + 68, 0x000000, "Click icons to open apps.");
                    nw::text(win_x + 108, body_y + 84, 0x000000, "Drag title bar to move.");
                    nw::text(win_x + 108, body_y + 100, 0x000000, "Resize from any edge.");

                    nw::rect(win_x + 106, body_y + 124, win_w - 128, 1, 0x00808080);
                    nw::rect(win_x + 106, body_y + 125, win_w - 128, 1, 0x00FFFFFF);

                    nw::text(win_x + 114, body_y + 140, 0x000080, "NwOS 26: GUI");
                    nw::text(win_x + 114, body_y + 158, 0x000000, "A desktop shell written in NwC.");
                    nw::text(win_x + 114, body_y + 174, 0x000000, "Files tab: real filesystem.");
                    nw::text(win_x + 114, body_y + 190, 0x000000, "Mine tab: 9x9 Minesweeper.");
                    nw::text(win_x + 130, win_y + win_h - 38, 0x00808080, "copyright NwOS 2026");
                }

                if (tab == 1) {
                    fm_path_s = nw::fs_path();
                    nw::text(win_x + 20, body_y + 6, 0x000080, fm_path_s);

                    nw::rect(win_x + 18, body_y + 24, win_w - 36, 1, 0x00808080);

                    /* ".." row */
                    nw::rect(win_x + 20, body_y + 30, win_w - 40, 16, 0x00E0E0E0);
                    nw::text(win_x + 26, body_y + 32, 0x00404040, "..");

                    fm_count = nw::fs_count();
                    fm_i = 0;
                    while (fm_i < fm_count) {
                        if (fm_i > 12) break;

                        fm_type = nw::fs_type(fm_i);
                        fm_name_s = nw::fs_name(fm_i);

                        if (fm_sel == fm_i) {
                            nw::rect(win_x + 20, body_y + 50 + fm_i * 18,
                                     win_w - 40, 16, 0x000080FF);
                        } else if (fm_i - ((fm_i / 2) * 2) == 0) {
                            nw::rect(win_x + 20, body_y + 50 + fm_i * 18,
                                     win_w - 40, 16, 0x00F5F5F5);
                        }

                        if (fm_type == 1) {
                            nw::text(win_x + 26, body_y + 52 + fm_i * 18,
                                     0x00000080, "[D]");
                            nw::text(win_x + 60, body_y + 52 + fm_i * 18,
                                     0x00000080, fm_name_s);
                        } else {
                            nw::text(win_x + 26, body_y + 52 + fm_i * 18,
                                     0x000000, "   ");
                            nw::text(win_x + 60, body_y + 52 + fm_i * 18,
                                     0x000000, fm_name_s);
                            fm_size = nw::fs_size(fm_i);
                            nw::text(win_x + win_w - 96,
                                     body_y + 52 + fm_i * 18,
                                     0x00808080, "bytes");
                            nw::text(win_x + win_w - 60,
                                     body_y + 52 + fm_i * 18,
                                     0x00808080, "?");
                        }
                        fm_i = fm_i + 1;
                    }

                    if (fm_count == 0) {
                        nw::text(win_x + 60, body_y + 52, 0x00808080, "(empty)");
                    }
                }

                if (tab == 2) {
                    grid_x = win_x + 60;
                    grid_y = body_y + 40;

                    nw::text(win_x + 20, body_y + 8, 0x000080,
                             "Mines left:");
                    nw::text(win_x + 140, body_y + 8, 0x800000,
                             "Right-click to flag");

                    if (ms_state == 1) {
                        nw::text(win_x + 20, body_y + 22, 0x000080,
                                 ">>> YOU WIN! <<<");
                    } else if (ms_state == 2) {
                        nw::text(win_x + 20, body_y + 22, 0x800000,
                                 ">>> BOOM! You lose <<<");
                    } else {
                        nw::text(win_x + 20, body_y + 22, 0x000000,
                                 "Click a cell to start.");
                    }

                    nw::rect(grid_x - 2, grid_y - 2,
                             9 * cell_sz + 4, 9 * cell_sz + 4, 0x00404040);

                    ms_i = 0;
                    while (ms_i < 81) {
                        ms_cx = ms_i - ((ms_i / 9) * 9);
                        ms_cy = ms_i / 9;
                        ms_nx = grid_x + ms_cx * cell_sz;
                        ms_ny = grid_y + ms_cy * cell_sz;

                        if (ms_revealed[ms_i] == 1) {
                            nw::rect(ms_nx, ms_ny, cell_sz, cell_sz, 0x00D0D0D0);
                            if (ms_mines[ms_i] == 1) {
                                nw::rect(ms_nx, ms_ny, cell_sz, cell_sz, 0x00A00000);
                                nw::text(ms_nx + 5, ms_ny + 4, 0x00FFFFFF, "*");
                            } else if (ms_adjacent[ms_i] > 0) {
                                if (ms_adjacent[ms_i] == 1) nw::rect(ms_nx + 6, ms_ny + 6, 6, 6, 0x000000FF);
                                if (ms_adjacent[ms_i] == 2) nw::rect(ms_nx + 6, ms_ny + 6, 6, 6, 0x00008000);
                                if (ms_adjacent[ms_i] == 3) nw::rect(ms_nx + 6, ms_ny + 6, 6, 6, 0x00A00000);
                                if (ms_adjacent[ms_i] == 4) nw::rect(ms_nx + 6, ms_ny + 6, 6, 6, 0x00000080);
                                if (ms_adjacent[ms_i] == 5) nw::rect(ms_nx + 6, ms_ny + 6, 6, 6, 0x00800000);
                                if (ms_adjacent[ms_i] == 6) nw::rect(ms_nx + 6, ms_ny + 6, 6, 6, 0x00008080);
                                if (ms_adjacent[ms_i] == 7) nw::rect(ms_nx + 6, ms_ny + 6, 6, 6, 0x00202020);
                                if (ms_adjacent[ms_i] == 8) nw::rect(ms_nx + 6, ms_ny + 6, 6, 6, 0x00606060);
                            }
                        } else {
                            nw::rect(ms_nx, ms_ny, cell_sz, cell_sz, 0x00C0C0C0);
                            nw::rect(ms_nx, ms_ny, cell_sz, 1, 0x00FFFFFF);
                            nw::rect(ms_nx, ms_ny, 1, cell_sz, 0x00FFFFFF);
                            nw::rect(ms_nx, ms_ny + cell_sz - 1, cell_sz, 1, 0x00808080);
                            nw::rect(ms_nx + cell_sz - 1, ms_ny, 1, cell_sz, 0x00808080);
                            if (ms_flagged[ms_i] == 1) {
                                nw::rect(ms_nx + 5, ms_ny + 4, 8, 8, 0x00FF0000);
                            }
                        }
                        ms_i = ms_i + 1;
                    }
                }
            }

            nw::rect(0, 696, 1280, 30, 0x00C0C0C0);
            nw::rect(0, 696, 1280, 2, 0x00FFFFFF);
            nw::rect(0, 694, 1280, 1, 0x00808080);

            nw::rect(4, 695, 88, 22, 0x00C0C0C0);
            nw::draw!FRAME << x=4,x2=92; y=695,y2=717; frame::no::window; !COLOR=WHITE;

            nw::rect(10, 699, 16, 16, 0x000000);
            nw::rect(11, 700, 14, 14, 0x000080);
            nw::rect(11, 700, 14, 1, 0x005858FF);
            nw::rect(11, 700, 1, 14, 0x005858FF);
            nw::draw!TEXT << x=14,y=703 !COLOR=WHITE << "N";
            nw::draw!TEXT << x=34,y=701 !COLOR=BLACK << "NwOS";

            nw::rect(360, 696, 1, 18, 0x00808080);
            nw::rect(361, 696, 1, 18, 0x00FFFFFF);
            nw::draw!TEXT << x=374,y=701 !COLOR=BLACK << "NwOS 26: GUI";
            nw::draw!TEXT << x=1184,y=701 !COLOR=BLACK << "12:00";

            if (start_open == 1) {
                nw::rect(7, 425, 228, 266, 0x00C0C0C0);
                nw::rect(8, 426, 226, 264, 0x00C0C0C0);
                nw::rect(9, 427, 26, 262, 0x00000080);
                nw::draw!TEXT << x=16,y=435 !COLOR=WHITE << "Nw";
                nw::draw!TEXT << x=16,y=451 !COLOR=WHITE << "OS";
                nw::draw!TEXT << x=16,y=467 !COLOR=WHITE << "26";

                nw::draw!FRAME << x=7,x2=235; y=425,y2=691; frame::no::window; !COLOR=BLACK;

                nw::rect(41, 434, 186, 24, 0x00000080);
                nw::draw!TEXT << x=50,y=442 !COLOR=WHITE << "Programs";

                nw::draw!TEXT << x=50,y=468 !COLOR=BLACK << "Documents";
