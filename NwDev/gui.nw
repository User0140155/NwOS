    if (inside(nw::mouse_x(), nw::mouse_y(), x, y, 128, 34) == 1) {
        nw::glass(x, y, 128, 34, 6, 0x00FFFFFF, 80);
    }
    call tx(x + 12, y + 13, 0x00FFFFFF, l2);
}

