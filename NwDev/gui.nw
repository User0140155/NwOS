                else if (inside(mx, my, 598, 652, 58, 48) == 1) {
                    call editor_app("note.txt", theme);
                    dirty = 1;
                }
                else if (inside(mx, my, 660, 652, 58, 48) == 1) {
                    call calculator_app(theme);
                    dirty = 1;
                }
                else if (inside(mx, my, 722, 652, 58, 48) == 1) {
                    theme = settings_app(theme);
                    dirty = 1;
                }
                else if (inside(mx, my, 784, 652, 58, 48) == 1) {
                    call monitor_app(theme);
                    dirty = 1;
                }
            }
        }
        if (dirty == 1) {
            call draw_desktop(theme, menu);
            nw::cursor(mx, my);
            nw::flush();
            dirty = 0;
        }
        lmx = mx;
        lmy = my;
        lastbtn = btn;
        sleep(8);
    }
    return 0;
}
