0A file_editor(str name) {
    1A k = 0;
    1A state = 0;

    nw::buf_load(name);

    while (state == 0) {
        nw::draw!FRAME << x=180,x2=1100; y=100,y2=620; frame::no::window; !COLOR=BLACK;
        nw::text(200, 116, 0x000080, name);
        nw::text(200, 134, 0x00808080, "TAB = save   ESC = cancel   BKSP = erase   ENTER = new line");
        nw::rect(200, 156, 880, 440, 0x00FFFFFF);
        nw::rect(200, 156, 880, 1, 0x00404040);
        nw::rect(200, 595, 880, 1, 0x00404040);
        nw::text(206, 164, 0x000000, nw::buf_text());
        nw::flush();

        k = nw::getkey();
        if (k == TAB) state = 1;
        else if (k == ESC) state = 2;
        else if (k == BACKSPACE) nw::buf_back();
        else if (k == ENTER) nw::buf_put(10);
        else if (k >= 32 && k <= 126) nw::buf_put(k);
    }

    if (state == 1) nw::buf_save(name);
}

0A file_delete_confirm(str name) {
    1A k = 0;

    nw::draw!FRAME << x=380,x2=900; y=300,y2=410; frame::no::window; !COLOR=BLACK;
    nw::text(400, 318, 0x000000, "Delete this file?");
    nw::text(400, 338, 0x000080, name);
    nw::text(400, 366, 0x00808080, "Enter = delete   Esc = cancel");
    nw::flush();

    k = nw::getkey();
    if (k == ENTER) nw::fs_delete(name);
}

