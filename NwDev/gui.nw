0A editor_app(str name, 1A theme) {
    1A key = 0;
    1A done = 0;
    1A cl = 1;
    1A cc = 0;
    nw::buf_load(name);
    cc = nw::buf_len();
    if (cc > 108) cc = 108;
    while (done == 0) {
        call editor_draw(theme, name, cl, cc);
        nw::cursor(nw::mouse_x(), nw::mouse_y());
        nw::flush();
        key = nw::getkey();
        if (key == 255) done = 1;
        if (key == 19) nw::buf_save(name);
        if (key == 256) {
            if (nw::buf_len() < 3900) {
                nw::buf_put(10);
                cl = cl + 1;
                cc = 0;
            }
        }
        if (key == 257) {
            nw::buf_back();
            if (cc > 0) cc = cc - 1;
            else if (cl > 1) {
                cl = cl - 1;
                cc = 0;
            }
        }
        if (key >= 32 && key <= 126) {
            if (nw::buf_len() < 3900) {
                nw::buf_put(key);
                cc = cc + 1;
            }
        }
    }
}

