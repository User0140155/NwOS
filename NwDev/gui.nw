// ---------- system monitor ----------
0A meter(1A x, 1A y, 1A mw, 1A v, 1A theme) {
    1A bar = v * mw / 100;
    if (bar > mw) bar = mw;
    nw::rgrad(x, y, mw, 64, 6, 0x00CFE3F0, 0x00EFF7FC);
    if (bar > 6) {
        nw::rgrad(x, y, bar, 64, 6, accent_lt(theme), accent(theme));
        nw::glass(x + 1, y + 1, bar - 2, 28, 5, 0x00FFFFFF, 85);
    }
}

0A monitor_panel(1A x, 1A y, 1A w, 1A h) {
    nw::rgrad(x, y, w, h, 8, 0x00FFFFFF, 0x00DCEBF5);
}

0A mon_draw(1A theme, 1A x, 1A y, 1A w, 1A h) {
    1A c = accent_dim(theme);
    1A cpu = nw::cpu_load();
    1A gpu = nw::gpu_load();
    1A up = nw::uptime_sec();
    1A cw = (w - 78) / 2;
    1A rx = x + 52 + cw;
    1A lx = x + 26;
    nw::text(lx, y + 64, 0x000E3A5C, "Performance");
    call monitor_panel(lx, y + 92, cw, 142);
    nw::text(lx + 18, y + 110, c, "CPU");
    nw::number(lx + cw - 70, y + 110, 0x000E3A5C, cpu);
    nw::text(lx + cw - 40, y + 110, 0x004F7896, "%");
    call meter(lx + 18, y + 140, cw - 36, cpu, theme);
    call monitor_panel(rx, y + 92, cw, 142);
    nw::text(rx + 18, y + 110, c, "GPU");
    nw::number(rx + cw - 70, y + 110, 0x000E3A5C, gpu);
    nw::text(rx + cw - 40, y + 110, 0x004F7896, "%");
    call meter(rx + 18, y + 140, cw - 36, gpu, theme);
    call monitor_panel(lx, y + 254, cw, 168);
    nw::text(lx + 18, y + 272, c, "MEMORY");
    nw::text(lx + 18, y + 302, 0x000E3A5C, "RAM");
    nw::number(lx + cw - 100, y + 302, 0x000E3A5C, nw::ram_mb());
    nw::text(lx + cw - 46, y + 302, 0x004F7896, "MB");
    nw::text(lx + 18, y + 332, 0x000E3A5C, "Disk used");
    nw::number(lx + cw - 100, y + 332, 0x000E3A5C, nw::disk_used_kb());
    nw::text(lx + cw - 46, y + 332, 0x004F7896, "KB");
    call monitor_panel(rx, y + 254, cw, 168);
    nw::text(rx + 18, y + 272, c, "SYSTEM");
    nw::text(rx + 18, y + 302, 0x000E3A5C, "Uptime");
    nw::number(rx + cw - 100, y + 302, 0x000E3A5C, up / 60);
    nw::text(rx + cw - 46, y + 302, 0x004F7896, "MIN");
    nw::number(rx + cw - 100, y + 326, 0x004F7896, up - (up / 60) * 60);
    nw::text(rx + cw - 68, y + 326, 0x004F7896, "SEC");
}

// ============================================================
//  window manager
//  w[] : 7 windows x 24 ints
//   +0 open  +1 mode(0 normal,2 maximized,3 fullscreen)
//   +2..5 normal rect  +6..9 effective rect  +10 minimized
//   +11 z-order stamp  +12.. per-app state
//  ids: 0 terminal 1 files 2 editor 3 calculator 4 settings
//       5 monitor 6 word generator
// ============================================================
1A main() {
    1A w[200];
    str words[15];
    str ename = "note.txt";
    str ttl = "";
    1A running = 1;
    1A theme = 0;
    1A menu = 0;
    1A dirty = 1;
    1A tick = 0;
    1A mx = 0;
    1A my = 0;
    1A lmx = -1;
    1A lmy = -1;
    1A btn = 0;
    1A lastbtn = 0;
    1A key = 0;
    1A i = 0;
    1A j = 0;
    1A b = 0;
    1A zc = 0;
    1A foc = -1;
    1A fz = 0;
    1A mzv = 0;
    1A fs = 0;
    1A req = -1;
    1A ldreq = 0;
    1A wadd = 0;
    1A fopen = 0;
    1A act = 0;
    1A aid = 0;
    1A ox = 0;
    1A oy = 0;
    1A rl = 0;
    1A rr = 0;
    1A rt = 0;
    1A rb = 0;
    1A x0 = 0;
    1A y0 = 0;
    1A w0 = 0;
    1A h0 = 0;
    1A sx = 0;
    1A sy = 0;
    1A cx = 0;
    1A cy = 0;
    1A cw = 0;
    1A ch = 0;
    1A md = 0;
    1A top = -1;
    1A tz = 0;
    1A hitf = 0;
    1A ts = 0;
    1A p = 1;
    1A st = 0;
    1A last = 0;
    1A pass = 0;
    1A best = 0;
    1A bz = 0;
    1A act2 = 0;
    1A n = 0;
    1A rows = 0;
    1A mxs = 0;
    1A cp = -1;
    1A r = 0;
    1A value = 0;
    1A acc = 0;
    1A op = 0;
    1A fresh = 1;
    1A error = 0;
    1A nop = 0;
    1A digit = 0;
    1A dx = 0;
    1A dy = 0;
    1A nx = 0;
    1A ny = 0;
    1A nww = 0;
    1A nhh = 0;
    1A mw = 0;
    1A mh = 0;
    1A qx = 0;
    1A qy = 0;
    1A chg = 0;
    i = 0;
    while (i < 200) {
        w[i] = 0;
        i = i + 1;
    }
    nw::buf_clear();
    while (running == 1) {
        mx = nw::mouse_x();
        my = nw::mouse_y();
        btn = nw::mouse_buttons();
        key = nw::pollkey();
        cp = -1;

        // ---- effective rects, focus, maximized stack ----
        foc = -1;
        fz = 0;
        mzv = 0;
        i = 0;
        while (i < 7) {
            b = i * 24;
            if (w[b] == 1) {
                w[b + 6] = w[b + 2];
                w[b + 7] = w[b + 3];
                w[b + 8] = w[b + 4];
                w[b + 9] = w[b + 5];
                if (w[b + 1] == 2) {
                    w[b + 6] = 0;
                    w[b + 7] = 0;
                    w[b + 8] = 1280;
                    w[b + 9] = 680;
                }
                if (w[b + 1] == 3) {
                    w[b + 6] = 0;
                    w[b + 7] = 0;
                    w[b + 8] = 1280;
                    w[b + 9] = 720;
                }
                if (w[b + 10] == 0) {
                    if (w[b + 11] > fz) {
                        fz = w[b + 11];
                        foc = i;
                    }
                    if (w[b + 1] >= 2) {
                        if (w[b + 11] > mzv) mzv = w[b + 11];
                    }
                }
            }
            i = i + 1;
        }
        fs = 0;
        if (foc >= 0) {
            if (w[foc * 24 + 1] == 3) fs = 1;
        }

        // ---- mouse press ----
        if (btn == 1 && lastbtn == 0) {
            dirty = 1;
            chg = 1;
            hitf = 0;
            if (menu == 1) {
                hitf = 1;
                if (inside(mx, my, 6, 232, 380, 444) == 1) {
                    j = 0;
                    while (j < 7) {
                        if (inside(mx, my, 18, 266 + j * 46, 216, 42) == 1) req = j;
                        j = j + 1;
                    }
                    if (inside(mx, my, 250, 316, 128, 34) == 1) {
                        nw::fs_enter("/");
                        req = 1;
                        w[36] = 99;
                        w[38] = 0;
                    }
                    if (inside(mx, my, 250, 356, 128, 34) == 1) {
                        nw::fs_enter("/home");
                        req = 1;
                        w[36] = 99;
                        w[38] = 0;
                    }
                    if (inside(mx, my, 250, 396, 128, 34) == 1) req = 4;
                    if (inside(mx, my, 250, 436, 128, 34) == 1) req = 5;
                    if (inside(mx, my, 16, 616, 100, 34) == 1) nw::reboot();
                    if (inside(mx, my, 124, 616, 100, 34) == 1) running = 0;
                    if (inside(mx, my, 250, 616, 128, 34) == 1) nw::poweroff();
                } else if (inside(mx, my, 5, 680, 58, 40) == 1) {
                    hitf = 0;
                } else {
                    menu = 0;
                }
            }
            if (hitf == 0 && fs == 0 && my >= 680) {
                hitf = 1;
                if (inside(mx, my, 5, 680, 58, 40) == 1) {
                    menu = 1 - menu;
                } else {
                    menu = 0;
                    j = 0;
                    while (j < 7) {
                        if (inside(mx, my, 76 + j * 52, 683, 48, 36) == 1) {
                            b = j * 24;
                            if (w[b] == 0) {
                                req = j;
                            } else if (w[b + 10] == 1) {
                                w[b + 10] = 0;
                                zc = zc + 1;
                                w[b + 11] = zc;
                            } else if (j == foc) {
                                w[b + 10] = 1;
                            } else {
                                zc = zc + 1;
                                w[b + 11] = zc;
                            }
                        }
                        j = j + 1;
                    }
                    if (inside(mx, my, 1262, 680, 18, 40) == 1) {
                        j = 0;
                        while (j < 7) {
                            if (w[j * 24] == 1) w[j * 24 + 10] = 1;
                            j = j + 1;
                        }
                    }
                }
            }
            if (hitf == 0) {
                top = -1;
                tz = 0;
                j = 0;
                while (j < 7) {
                    b = j * 24;
                    if (w[b] == 1) {
                        if (w[b + 10] == 0) {
                            if (w[b + 11] > tz) {
                                if (w[b + 1] == 0) {
                                    if (inside(mx, my, w[b + 6] - 5, w[b + 7] - 5, w[b + 8] + 10, w[b + 9] + 10) == 1) {
                                        top = j;
                                        tz = w[b + 11];
                                    }
                                } else {
                                    if (inside(mx, my, w[b + 6], w[b + 7], w[b + 8], w[b + 9]) == 1) {
                                        top = j;
                                        tz = w[b + 11];
                                    }
                                }
                            }
                        }
                    }
                    j = j + 1;
                }
                if (top >= 0) {
                    b = top * 24;
                    zc = zc + 1;
                    w[b + 11] = zc;
                    cx = w[b + 6];
                    cy = w[b + 7];
                    cw = w[b + 8];
                    ch = w[b + 9];
                    md = w[b + 1];
                    if (inside(mx, my, cx + cw - 38, cy + 8, 26, 22) == 1) {
                        w[b] = 0;
                    } else if (inside(mx, my, cx + cw - 68, cy + 8, 26, 22) == 1) {
                        if (md == 2) w[b + 1] = 0;
                        else w[b + 1] = 2;
                    } else if (inside(mx, my, cx + cw - 98, cy + 8, 26, 22) == 1) {
                        w[b + 10] = 1;
                    } else if (inside(mx, my, cx + cw - 128, cy + 8, 26, 22) == 1) {
                        if (md == 3) w[b + 1] = 0;
                        else w[b + 1] = 3;
                    } else {
                        rl = 0;
                        rr = 0;
                        rt = 0;
                        rb = 0;
                        if (md == 0) {
                            if (mx <= cx + 5) rl = 1;
                            if (mx >= cx + cw - 5) rr = 1;
                            if (my <= cy + 5) rt = 1;
                            if (my >= cy + ch - 5) rb = 1;
                        }
                        if (rl + rr + rt + rb > 0) {
                            act = 2;
                            aid = top;
                            x0 = cx;
                            y0 = cy;
                            w0 = cw;
                            h0 = ch;
                            sx = mx;
                            sy = my;
                        } else if (inside(mx, my, cx, cy, cw - 134, 34) == 1) {
                            if (md == 0) {
                                act = 1;
                                aid = top;
                                ox = mx - cx;
                                oy = my - cy;
                            }
                        } else {
                            // ---- clicks inside the window ----
                            if (top == 0) {
                                if (inside(mx, my, cx + cw - 34, cy + 42, 20, ch - 104) == 1) {
                                    act = 3;
                                    aid = 0;
                                }
                            }
                            if (top == 1) {
                                if (inside(mx, my, cx + 24, cy + 80, 92, 28) == 1) {
                                    nw::fs_up();
                                    w[b + 12] = 99;
                                    w[b + 13] = 0;
                                    w[b + 14] = 0;
                                }
                                if (inside(mx, my, cx + 126, cy + 80, 104, 28) == 1) {
                                    nw::fs_enter("/");
                                    w[b + 12] = 99;
                                    w[b + 13] = 0;
                                    w[b + 14] = 0;
                                }
                                if (inside(mx, my, cx + 240, cy + 80, 116, 28) == 1) fopen = 1;
                                if (inside(mx, my, cx + 24, cy + 150, 150, 24) == 1) {
                                    nw::fs_enter("/");
                                    w[b + 12] = 99;
                                    w[b + 13] = 0;
                                    w[b + 14] = 0;
                                }
                                if (inside(mx, my, cx + 24, cy + 178, 150, 24) == 1) {
                                    nw::fs_enter("/home");
                                    w[b + 12] = 99;
                                    w[b + 13] = 0;
                                    w[b + 14] = 0;
                                }
                                if (inside(mx, my, cx + 24, cy + 206, 150, 24) == 1) {
                                    nw::fs_enter("/sys");
                                    w[b + 12] = 99;
                                    w[b + 13] = 0;
                                    w[b + 14] = 0;
                                }
                                if (inside(mx, my, cx + 24, cy + 234, 150, 24) == 1) {
                                    nw::fs_enter("/bin");
                                    w[b + 12] = 99;
                                    w[b + 13] = 0;
                                    w[b + 14] = 0;
                                }
                                rows = (ch - 184 - 24) / 23;
                                if (mx >= cx + 198 && mx <= cx + cw - 24 && my >= cy + 184 && my < cy + 184 + rows * 23) {
                                    j = w[b + 14] + (my - cy - 184) / 23;
                                    n = nw::fs_count();
                                    if (j < n) {
                                        w[b + 13] = 0;
                                        if (nw::fs_type(j) == 1) {
                                            nw::fs_enter(nw::fs_name(j));
                                            w[b + 12] = 99;
                                            w[b + 14] = 0;
                                        } else {
                                            w[b + 12] = j;
                                        }
                                    }
                                }
                            }
                            if (top == 3) {
                                cp = pad_hit(mx, my, cx + 16, cy + 146, (cw - 32) / 4, (ch - 160) / 4);
                            }
                            if (top == 4) {
                                j = 0;
                                while (j < 4) {
                                    if (inside(mx, my, cx + card_x(cw, j), cy + card_y(j), card_w(cw), 112) == 1) theme = j;
                                    j = j + 1;
                                }
                            }
                        }
                    }
                } else {
                    menu = 0;
                    j = 0;
                    while (j < 6) {
                        if (inside(mx, my, 16, 18 + j * 88, 76, 84) == 1) req = j;
                        j = j + 1;
                    }
                    if (inside(mx, my, 1030, 40, 210, 120) == 1) req = 6;
                }
            }
        }

        // ---- drag / resize / scrollbar while the button is held ----
        if (btn == 0) act = 0;
        if (act == 1) {
            b = aid * 24;
            w[b + 2] = clampi(mx - ox, 140 - w[b + 4], 1220);
            w[b + 3] = clampi(my - oy, 0, 650);
        }
        if (act == 2) {
            b = aid * 24;
            mw = minsz(aid, 0);
            mh = minsz(aid, 1);
            dx = mx - sx;
            dy = my - sy;
            nx = x0;
            ny = y0;
            nww = w0;
            nhh = h0;
            if (rl == 1) {
                nww = w0 - dx;
                if (nww < mw) nww = mw;
                nx = x0 + w0 - nww;
            }
            if (rr == 1) {
                nww = w0 + dx;
                if (nww < mw) nww = mw;
            }
            if (rt == 1) {
                nhh = h0 - dy;
                if (nhh < mh) nhh = mh;
                ny = y0 + h0 - nhh;
                if (ny < 0) {
                    nhh = nhh + ny;
                    ny = 0;
                }
            }
            if (rb == 1) {
                nhh = h0 + dy;
                if (nhh < mh) nhh = mh;
            }
            if (nww > 1280) nww = 1280;
            if (nhh > 680) nhh = 680;
            w[b + 2] = nx;
            w[b + 3] = ny;
            w[b + 4] = nww;
            w[b + 5] = nhh;
        }
        if (act == 3) {
            rows = trows(w[9]);
            n = nw::shi(0, 0);
            mxs = n - rows;
            if (mxs > 0) {
                dy = w[9] - 116;
                dx = clampi(my - (w[7] + 48), 0, dy);
                w[12] = mxs - (dx * mxs) / dy;
            }
        }

        // ---- keyboard ----
        if (key != 0) {
            dirty = 1;
            chg = 1;
            if (key == 267) {
                req = 6;
                wadd = 1;
            }
            if (key == 276) {
                if (foc >= 0) {
                    b = foc * 24;
                    if (w[b + 1] == 3) w[b + 1] = 0;
                    else w[b + 1] = 3;
                }
            }
            if (key == 263) menu = 1 - menu;
            if (key == 255) {
                if (menu == 1) {
                    menu = 0;
                } else if (foc >= 0) {
                    w[foc * 24] = 0;
                }
            }
            if (foc == 0) {
                rows = trows(w[9]);
                if (key >= 32 && key <= 126) {
                    if (nw::shi(3, 0) < tcols(w[8]) - 14) nw::shi(4, key);
                    w[12] = 0;
                }
                if (key == 257) nw::shi(5, 0);
                if (key == 256) {
                    r = nw::shi(6, 0);
                    w[12] = 0;
                    if (r == 10) req = 3;
                    if (r == 11) {
                        ename = nw::shs(2, 0);
                        ldreq = 1;
                        req = 2;
                    }
                    if (r == 12) req = 1;
                    if (r == 13) req = 4;
                    if (r == 14) w[0] = 0;
                    if (r == 15) req = 5;
                }
                if (key == 259) nw::shi(7, 0);
                if (key == 260) nw::shi(8, 0);
                if (key == 280) w[12] = w[12] + rows - 1;
                if (key == 281) w[12] = w[12] - rows + 1;
                if (key == 278) w[12] = 100000;
                if (key == 279) w[12] = 0;
            }
            if (foc == 1) {
                n = nw::fs_count();
                rows = (w[33] - 184 - 24) / 23;
                if (key == 259) {
                    if (w[36] >= 99) w[36] = 0;
                    else if (w[36] > 0) w[36] = w[36] - 1;
                }
                if (key == 260) {
                    if (w[36] >= 99) w[36] = 0;
                    else if (w[36] < n - 1) w[36] = w[36] + 1;
                }
                if (w[36] < w[38]) w[38] = w[36];
                if (w[36] < 99) {
                    if (w[36] >= w[38] + rows) w[38] = w[36] - rows + 1;
                }
                if (key == 256) fopen = 1;
                if (key == 257) {
                    nw::fs_up();
                    w[36] = 99;
                    w[37] = 0;
                    w[38] = 0;
                }
            }
            if (foc == 2) {
                if (key == 19) nw::buf_save(ename);
                if (key == 256) {
                    if (nw::buf_len() < 3900) {
                        nw::buf_put(10);
                        w[60] = w[60] + 1;
                        w[61] = 0;
                    }
                }
                if (key == 257) {
                    nw::buf_back();
                    if (w[61] > 0) {
                        w[61] = w[61] - 1;
                    } else if (w[60] > 1) {
                        w[60] = w[60] - 1;
                        w[61] = 0;
                    }
                }
                if (key >= 32 && key <= 126) {
                    if (nw::buf_len() < 3900) {
                        nw::buf_put(key);
                        w[61] = w[61] + 1;
                    }
                }
            }
            if (foc == 3) {
                digit = key - 48;
                if (digit >= 0 && digit <= 9) {
                    if (digit == 0) cp = 13;
                    if (digit >= 7) cp = digit - 7;
                    if (digit >= 4 && digit <= 6) cp = digit;
                    if (digit >= 1 && digit <= 3) cp = digit + 7;
                }
                if (key == 47) cp = 3;
                if (key == 42) cp = 7;
                if (key == 45) cp = 11;
                if (key == 43) cp = 15;
                if (key == 61 || key == 256) cp = 14;
                if (key == 99 || key == 67 || key == 257) cp = 12;
            }
        }

        // ---- calculator ----
        if (cp >= 0) {
            value = w[84];
            acc = w[85];
            op = w[86];
            fresh = w[87];
            error = w[88];
            if (cp == 12) {
                value = 0;
                acc = 0;
                op = 0;
                fresh = 1;
                error = 0;
            } else if (cp == 14) {
                if (op != 0 && fresh == 0 && error == 0) {
                    value = apply(acc, value, op);
                    if (value == 2000000000) {
                        error = 1;
                        value = 0;
                    }
                }
                op = 0;
                fresh = 1;
            } else if (cp == 3 || cp == 7 || cp == 11 || cp == 15) {
                nop = 0;
                if (cp == 3) nop = 4;
                if (cp == 7) nop = 3;
                if (cp == 11) nop = 2;
                if (cp == 15) nop = 1;
                if (op != 0 && fresh == 0 && error == 0) {
                    value = apply(acc, value, op);
                    if (value == 2000000000) {
                        error = 1;
                        value = 0;
                    }
                }
                acc = value;
                op = nop;
                fresh = 1;
            } else {
                digit = 0;
                if (cp <= 2) digit = cp + 7;
                if (cp >= 4 && cp <= 6) digit = cp;
                if (cp >= 8 && cp <= 10) digit = cp - 7;
                if (cp == 13) digit = 0;
                if (fresh == 1 || error == 1) {
                    value = digit;
                    fresh = 0;
                    error = 0;
                } else if (value < 10000000) {
                    value = value * 10 + digit;
                }
            }
            w[84] = value;
            w[85] = acc;
            w[86] = op;
            w[87] = fresh;
            w[88] = error;
            dirty = 1;
            chg = 1;
        }

        // ---- file manager: open the selected item ----
        if (fopen == 1) {
            fopen = 0;
            n = nw::fs_count();
            j = w[36];
            if (j < n) {
                if (nw::fs_type(j) == 1) {
                    nw::fs_enter(nw::fs_name(j));
                    w[36] = 99;
                    w[37] = 0;
                    w[38] = 0;
                } else if (nw::fs_size(j) > 4096) {
                    w[37] = 1;
                } else {
                    ename = nw::fs_name(j);
                    ldreq = 1;
                    req = 2;
                }
            }
            dirty = 1;
            chg = 1;
        }

        // ---- open / focus an application ----
        if (req >= 0) {
            b = req * 24;
            menu = 0;
            dirty = 1;
            chg = 1;
            if (w[b] == 0) {
                w[b] = 1;
                w[b + 1] = 0;
                w[b + 2] = dflt(req, 0);
                w[b + 3] = dflt(req, 1);
                w[b + 4] = dflt(req, 2);
                w[b + 5] = dflt(req, 3);
                j = 10;
                while (j < 24) {
                    w[b + j] = 0;
                    j = j + 1;
                }
                if (req == 1) w[b + 12] = 99;
                if (req == 3) w[b + 15] = 1;
                if (req == 0) {
                    if (nw::shi(0, 0) <= 1) nw::shi(11, 0);
                }
                if (req == 2) {
                    if (ldreq == 0) ename = "note.txt";
                    ldreq = 1;
                }
            }
            if (req == 2) {
                if (ldreq == 1) {
                    nw::buf_load(ename);
                    w[b + 12] = 1;
                    w[b + 13] = nw::buf_len();
                    if (w[b + 13] > 100) w[b + 13] = 100;
                }
            }
            w[b + 10] = 0;
            zc = zc + 1;
            w[b + 11] = zc;
            req = -1;
            ldreq = 0;
        }
        if (wadd == 1) {
            wadd = 0;
            if (w[156] >= 15) w[156] = 0;
            words[w[156]] = nw::random_word();
            w[156] = w[156] + 1;
        }

        // ---- terminal scroll limits ----
        if (w[0] == 1) {
            rows = trows(w[9]);
            mxs = nw::shi(0, 0) - rows;
            if (mxs < 0) mxs = 0;
            if (w[12] > mxs) w[12] = mxs;
            if (w[12] < 0) w[12] = 0;
        }

        // ---- periodic refresh (clock, monitor) ----
        tick = tick + 1;
        if (tick >= 240) {
            tick = 0;
            dirty = 1;
        }
        if (w[120] == 1) {
            if (w[130] == 0) {
                if (tick - (tick / 12) * 12 == 0) dirty = 1;
            }
        }
        if (mx != lmx || my != lmy || btn != lastbtn) dirty = 1;

        // ---- draw ----
        if (dirty == 1 && chg == 1) {
            chg = 0;
        } else if (dirty == 1) {
            if (mzv == 0) call desk(theme);
            last = 0;
            if (mzv > 0) last = mzv - 1;
            pass = 0;
            while (pass < 7) {
                best = -1;
                bz = 1000000000;
                i = 0;
                while (i < 7) {
                    b = i * 24;
                    if (w[b] == 1) {
                        if (w[b + 10] == 0) {
                            if (w[b + 11] > last) {
                                if (w[b + 11] < bz) {
                                    bz = w[b + 11];
                                    best = i;
                                }
                            }
                        }
                    }
                    i = i + 1;
                }
                if (best < 0) {
                    pass = 7;
                } else {
                    b = best * 24;
                    cx = w[b + 6];
                    cy = w[b + 7];
                    cw = w[b + 8];
                    ch = w[b + 9];
                    act2 = 0;
                    if (best == foc) act2 = 1;
                    if (best == 0) ttl = "NwOS Terminal";
                    if (best == 1) ttl = "File Manager";
                    if (best == 2) ttl = "Text Editor";
                    if (best == 3) ttl = "Calculator";
                    if (best == 4) ttl = "System Settings";
                    if (best == 5) ttl = "System Monitor";
                    if (best == 6) ttl = "Word Generator";
                    call chrome(theme, cx, cy, cw, ch, ttl, act2, w[b + 1]);
                    if (best == 0) call term_draw(theme, cx, cy, cw, ch, w[b + 12]);
                    if (best == 1) call files_draw(theme, cx, cy, cw, ch, w[b + 12], w[b + 13], w[b + 14]);
                    if (best == 2) call edit_draw(theme, cx, cy, cw, ch, ename, w[b + 12], w[b + 13]);
                    if (best == 3) call calc_draw(theme, cx, cy, cw, ch, w[b + 12], w[b + 16]);
                    if (best == 4) call set_draw(theme, cx, cy, cw, ch);
                    if (best == 5) call mon_draw(theme, cx, cy, cw, ch);
                    if (best == 6) {
                        nw::text(cx + 24, cy + 58, 0x004F7896, "F7 adds a word");
                        nw::number(cx + cw - 62, cy + 58, accent_dim(theme), w[b + 12]);
                        nw::text(cx + cw - 36, cy + 58, 0x004F7896, "/15");
                        j = 0;
                        while (j < w[b + 12]) {
                            qx = cx + 24 + (j / 5) * ((cw - 48) / 3);
                            qy = cy + 92 + (j - (j / 5) * 5) * 34;
                            nw::rgrad(qx - 8, qy - 8, (cw - 48) / 3 - 10, 24, 8, 0x00FFFFFF, 0x00C7E0F0);
                            nw::text(qx, qy, 0x000E3A5C, words[j]);
                            j = j + 1;
                        }
                        if (w[b + 12] == 0) nw::text(cx + 24, cy + 100, 0x004F7896, "Press F7 to generate.");
                    }
                    last = bz;
                    pass = pass + 1;
                }
            }
            if (fs == 0) {
                ts = 0;
                p = 1;
                i = 0;
                while (i < 7) {
                    b = i * 24;
                    st = 0;
                    if (w[b] == 1) {
                        st = 1;
                        if (w[b + 10] == 1) st = 3;
                        else if (i == foc) st = 2;
                    }
                    ts = ts + st * p;
                    p = p * 4;
                    i = i + 1;
                }
                call taskbar(theme, ts, menu);
                if (menu == 1) call startmenu(theme);
            }
            nw::cursor(mx, my);
            nw::flush();
            dirty = 0;
        }
        lmx = mx;
        lmy = my;
        lastbtn = btn;
        sleep(8);
    }
    return 0;
}
