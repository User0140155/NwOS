                if (new_h < 300) {
                    if (rz_top == 1) new_y = (w_y[rz_id] + w_h[rz_id]) - 300;
                    new_h = 300;
                }
                if (new_x < 0) { new_w = new_w + new_x; new_x = 0; }
                if (new_y < 0) { new_h = new_h + new_y; new_y = 0; }
                if (new_x + new_w > 1280) new_w = 1280 - new_x;
                if (new_y + new_h > 690) new_h = 690 - new_y;

                if (new_x != w_x[rz_id]) { w_x[rz_id] = new_x; dirty = 1; }
                if (new_y != w_y[rz_id]) { w_y[rz_id] = new_y; dirty = 1; }
