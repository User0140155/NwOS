#include <nwc.h>

1A calc_apply(1A a, 1A b, 1A op) {
    if (op == 1) return a + b;
    if (op == 2) return a - b;
    if (op == 3) return a * b;
    if (op == 4) {
        if (b == 0) return 0;
        return a / b;
    }
    return b;
}


0A draw_two(1A x, 1A y, 1A v) {
    if (v < 10) nw::text(x, y, 0x000000, "0");
    if (v < 10) nw::number(x + 8, y, 0x000000, v);
    else nw::number(x, y, 0x000000, v);
}

0A file_prompt_new() {
    1A k = 0;
    1A state = 0;

    nw::buf_clear();

    while (state == 0) {
        nw::draw!FRAME << x=330,x2=950; y=290,y2=420; frame::no::window; !COLOR=BLACK;
        nw::text(348, 308, 0x000000, "New file name (Enter = create, Esc = cancel)");
        nw::rect(348, 336, 584, 24, 0x00FFFFFF);
        nw::rect(348, 336, 584, 1, 0x00404040);
        nw::rect(348, 359, 584, 1, 0x00404040);
        nw::text(354, 344, 0x000000, nw::buf_text());
        if (nw::buf_len() == 0) nw::text(354, 344, 0x00808080, "_");
        nw::flush();

        k = nw::getkey();
        if (k == ENTER) state = 1;
        else if (k == ESC) state = 2;
        else if (k == BACKSPACE) nw::buf_back();
        else if (k >= 32 && k <= 126) nw::buf_put(k);
    }

    if (state == 1 && nw::buf_len() > 0) {
        nw::fs_create(nw::buf_text());
    }
}

