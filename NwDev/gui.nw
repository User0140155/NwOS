1A pad_hit(1A mx, 1A my, 1A gx, 1A gy) {
    1A col = 0;
    1A row = 0;
    if (mx < gx || my < gy) return -1;
    col = (mx - gx) / 78;
    row = (my - gy) / 62;
    if (col < 0 || col > 3 || row < 0 || row > 3) return -1;
    if (inside(mx, my, gx + col * 78, gy + row * 62, 70, 52) == 0) return -1;
    return row * 4 + col;
}

1A apply(1A a, 1A b, 1A o) {
    if (o == 1) return a + b;
    if (o == 2) return a - b;
    if (o == 3) return a * b;
    if (o == 4) return a / b;
    return a;
}

0A calculator_app(1A theme) {
    1A open = 1;
    1A dirty = 1;
    1A mx = 0;
    1A my = 0;
    1A lmx = -1;
    1A lmy = -1;
    1A btn = 0;
    1A lastbtn = 0;
    1A hit = -1;
    1A value = 0;
    1A acc = 0;
    1A op = 0;
    1A fresh = 1;
    1A error = 0;
    1A digit = 0;
    1A nop = 0;
    while (open == 1) {
        mx = nw::mouse_x();
        my = nw::mouse_y();
        btn = nw::mouse_buttons();
        if (mx != lmx || my != lmy || btn != lastbtn) dirty = 1;
        if (btn == 1 && lastbtn == 0) {
            if (close_hit(mx, my, 460, 100, 360) == 1) open = 0;
            hit = pad_hit(mx, my, 488, 274);
            if (hit >= 0) {
                if (hit == 12) {
                    value = 0;
                    acc = 0;
                    op = 0;
                    fresh = 1;
                    error = 0;
                }
                else if (hit == 14) {
                    if (op != 0 && fresh == 0 && error == 0) {
                        if (op == 4 && value == 0) {
                            error = 1;
                            value = 0;
                        } else {
                            value = apply(acc, value, op);
                        }
                    }
                    op = 0;
                    fresh = 1;
                }
                else if (hit == 3 || hit == 7 || hit == 11 || hit == 15) {
                    nop = 0;
                    if (hit == 3) nop = 4;
                    if (hit == 7) nop = 3;
                    if (hit == 11) nop = 2;
                    if (hit == 15) nop = 1;
                    if (op != 0 && fresh == 0 && error == 0) {
                        if (op == 4 && value == 0) {
                            error = 1;
                            value = 0;
                        } else {
                            value = apply(acc, value, op);
                        }
                    }
                    acc = value;
                    op = nop;
                    fresh = 1;
                }
                else {
                    digit = 0;
                    if (hit <= 2) digit = hit + 7;
                    if (hit >= 4 && hit <= 6) digit = hit;
                    if (hit >= 8 && hit <= 10) digit = hit - 7;
                    if (hit == 13) digit = 0;
                    if (fresh == 1 || error == 1) {
                        value = digit;
                        fresh = 0;
                        error = 0;
                    } else {
                        value = value * 10 + digit;
                    }
                }
                dirty = 1;
            }
        }
        if (dirty == 1) {
            call calculator_draw(theme, value, error);
            nw::cursor(mx, my);
            nw::flush();
            dirty = 0;
        }
        lmx = mx;
        lmy = my;
        lastbtn = btn;
        sleep(8);
    }
}

