// ---------- terminal ----------
0A term_draw(1A theme, 1A x, 1A y, 1A w, 1A h, 1A sc) {
    1A c = accent_lt(theme);
    1A px = x + 14;
    1A py = y + 42;
    1A pw = w - 28;
    1A ph = h - 104;
    1A rows = trows(h);
    1A cols = tcols(w);
    1A n = nw::shi(0, 0);
    1A first = 0;
    1A i = 0;
    1A idx = 0;
    1A mxs = 0;
    1A tl = ph - 12;
    1A th = 0;
    1A tp = 0;
    nw::rgrad(px - 1, py - 1, pw + 2, ph + 2, 7, 0x002F6C94, 0x002F6C94);
    nw::rgrad(px, py, pw, ph, 6, 0x00123049, 0x00061622);
    nw::glass(px + 1, py + 1, pw - 2, 20, 5, 0x00FFFFFF, 18);
    first = n - rows - sc;
    if (first < 0) first = 0;
    i = 0;
    while (i < rows) {
        idx = first + i;
        if (idx < n) nw::text(px + 12, py + 8 + i * 14, nw::shi(1, idx), nw::shs(5, idx + cols * 4096));
        i = i + 1;
    }
    mxs = n - rows;
    nw::rgrad(px + pw - 16, py + 6, 10, tl, 4, 0x00071826, 0x00071826);
    if (mxs > 0) {
        th = tl * rows / n;
        if (th < 24) th = 24;
        tp = (tl - th) * (mxs - sc) / mxs;
        nw::rgrad(px + pw - 16, py + 6 + tp, 10, th, 4, accent_lt(theme), accent(theme));
        nw::glass(px + pw - 15, py + 7 + tp, 8, th / 2, 3, 0x00FFFFFF, 80);
    } else {
        nw::rgrad(px + pw - 16, py + 6, 10, tl, 4, 0x00183A56, 0x00183A56);
    }
    nw::rgrad(px - 1, y + h - 53, pw + 2, 34, 7, 0x002F6C94, 0x002F6C94);
    nw::rgrad(px, y + h - 52, pw, 32, 6, 0x00123049, 0x00061622);
    nw::text(px + 12, y + h - 42, c, "user@nwos$");
    nw::text(px + 100, y + h - 42, 0x00FFFFFF, nw::shs(1, 0));
    nw::rect(px + 100 + nw::shi(3, 0) * 8, y + h - 44, 7, 12, c);
}

// ---------- calculator ----------
0A key_label(1A i, 1A bx, 1A by, 1A bw, 1A bh) {
    1A col = i - (i / 4) * 4;
    1A row = i / 4;
    1A lx = bx + bw / 2 - 4;
    1A ly = by + bh / 2 - 4;
    if (col < 3 && row < 3) nw::number(lx, ly, 0x000E3A5C, (2 - row) * 3 + col + 1);
    if (i == 13) nw::number(lx, ly, 0x000E3A5C, 0);
    if (i == 3) call tx(lx, ly, 0x00FFFFFF, "/");
    if (i == 7) call tx(lx, ly, 0x00FFFFFF, "*");
    if (i == 11) call tx(lx, ly, 0x00FFFFFF, "-");
    if (i == 12) call tx(lx, ly, 0x00FFFFFF, "C");
    if (i == 14) call tx(lx, ly, 0x00FFFFFF, "=");
    if (i == 15) call tx(lx, ly, 0x00FFFFFF, "+");
}

0A calc_draw(1A theme, 1A x, 1A y, 1A w, 1A h, 1A value, 1A error) {
    1A gx = x + 16;
    1A gy = y + 146;
    1A pw = (w - 32) / 4;
    1A ph = (h - 160) / 4;
    1A hit = pad_hit(nw::mouse_x(), nw::mouse_y(), gx, gy, pw, ph);
    1A i = 0;
    1A bx = 0;
    1A by = 0;
    1A col = 0;
    1A tone = 4;
    nw::rgrad(x + 15, y + 45, w - 30, 92, 8, 0x007FA9C4, 0x007FA9C4);
    nw::rgrad(x + 16, y + 46, w - 32, 90, 7, 0x00F8FDFF, 0x00D2E8F5);
    nw::text(x + 32, y + 60, 0x004F7896, "RESULT");
    if (error == 1) {
        nw::text(x + 32, y + 100, 0x00C0392B, "Error");
    } else {
        nw::number(x + 32, y + 100, 0x000E3A5C, value);
    }
    i = 0;
    while (i < 16) {
        col = i - (i / 4) * 4;
        bx = gx + col * pw;
        by = gy + (i / 4) * ph;
        tone = 4;
        if (col == 3) tone = theme;
        if (i == 12) tone = 5;
        if (i == 14) tone = 1;
        if (i == hit) call gbtn(bx, by, pw - 8, ph - 8, tone, 1);
        else call gbtn(bx, by, pw - 8, ph - 8, tone, 0);
        call key_label(i, bx, by, pw - 8, ph - 8);
        i = i + 1;
    }
}

// ---------- file manager ----------
0A place(1A x, 1A y, 1A sel, str label) {
    str l2 = label;
    if (sel == 1) nw::rgrad(x, y, 150, 24, 5, 0x00E8F8FF, 0x009FD8F6);
    else nw::rgrad(x, y, 150, 24, 5, 0x00F7FBFE, 0x00E3EFF7);
    nw::text(x + 14, y + 8, 0x000E3A5C, l2);
}

0A files_draw(1A theme, 1A x, 1A y, 1A w, 1A h, 1A selected, 1A notice, 1A top) {
    1A n = nw::fs_count();
    1A rv = (h - 184 - 24) / 23;
    1A i = 0;
    1A idx = 0;
    1A yy = 0;
    1A mx = nw::mouse_x();
    1A my = nw::mouse_y();
    nw::text(x + 24, y + 58, 0x004F7896, nw::fs_path());
    call gbtn(x + 24, y + 80, 92, 28, 4, inside(mx, my, x + 24, y + 80, 92, 28));
    nw::text(x + 52, y + 90, 0x000E3A5C, "Up");
    call gbtn(x + 126, y + 80, 104, 28, 4, inside(mx, my, x + 126, y + 80, 104, 28));
    nw::text(x + 160, y + 90, 0x000E3A5C, "Root");
    call gbtn(x + 240, y + 80, 116, 28, theme, inside(mx, my, x + 240, y + 80, 116, 28));
    call tx(x + 262, y + 90, 0x00FFFFFF, "Open file");
    nw::text(x + 24, y + 128, accent_dim(theme), "PLACES");
    call place(x + 24, y + 150, 1, "Root  /");
    call place(x + 24, y + 178, 0, "Home  /home");
    call place(x + 24, y + 206, 0, "System  /sys");
    call place(x + 24, y + 234, 0, "Bin  /bin");
    if (notice == 1) nw::text(x + 24, y + 278, 0x00C0392B, "File too large.");
    nw::rgrad(x + 198, y + 126, w - 222, 38, 5, 0x00FFFFFF, 0x00D6E8F4);
    nw::text(x + 210, y + 144, 0x004F7896, "TYPE");
    nw::text(x + 280, y + 144, 0x004F7896, "NAME");
    nw::text(x + w - 158, y + 144, 0x004F7896, "SIZE");
    i = 0;
    while (i < rv) {
        idx = top + i;
        yy = y + 184 + i * 23;
        if (idx < n) {
            if (idx == selected) {
                nw::rgrad(x + 198, yy, w - 222, 22, 4, 0x00BFE8FC, 0x008FD0F4);
            } else if (i - (i / 2) * 2 == 0) {
                nw::rect(x + 198, yy, w - 222, 22, 0x00FFFFFF);
            } else {
                nw::rect(x + 198, yy, w - 222, 22, 0x00EEF6FB);
            }
            if (nw::fs_type(idx) == 1) {
                nw::text(x + 210, yy + 7, 0x002E9E4F, "DIR");
            } else {
                nw::text(x + 210, yy + 7, 0x004F7896, "FILE");
                nw::number(x + w - 158, yy + 7, 0x004F7896, nw::fs_size(idx));
            }
            nw::text(x + 280, yy + 7, 0x000E3A5C, nw::fs_name(idx));
        }
        i = i + 1;
    }
    if (n == 0) nw::text(x + 210, y + 188, 0x004F7896, "This directory is empty.");
}

