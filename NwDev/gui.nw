// ---------- window geometry tables ----------
// f: 0 x, 1 y, 2 width, 3 height
1A dflt(1A id, 1A f) {
    1A v = 0;
    if (id == 0) {
        if (f == 0) v = 100;
        if (f == 1) v = 70;
        if (f == 2) v = 1080;
        if (f == 3) v = 560;
    }
    if (id == 1) {
        if (f == 0) v = 120;
        if (f == 1) v = 66;
        if (f == 2) v = 1040;
        if (f == 3) v = 568;
    }
    if (id == 2) {
        if (f == 0) v = 160;
        if (f == 1) v = 74;
        if (f == 2) v = 960;
        if (f == 3) v = 552;
    }
    if (id == 3) {
        if (f == 0) v = 460;
        if (f == 1) v = 90;
        if (f == 2) v = 360;
        if (f == 3) v = 520;
    }
    if (id == 4) {
        if (f == 0) v = 220;
        if (f == 1) v = 74;
        if (f == 2) v = 840;
        if (f == 3) v = 552;
    }
    if (id == 5) {
        if (f == 0) v = 250;
        if (f == 1) v = 94;
        if (f == 2) v = 780;
        if (f == 3) v = 500;
    }
    if (id == 6) {
        if (f == 0) v = 390;
        if (f == 1) v = 140;
        if (f == 2) v = 500;
        if (f == 3) v = 370;
    }
    return v;
}

// f: 0 minimum width, 1 minimum height
1A minsz(1A id, 1A f) {
    1A v = 0;
    if (id == 0) { if (f == 0) v = 420; else v = 260; }
    if (id == 1) { if (f == 0) v = 560; else v = 340; }
    if (id == 2) { if (f == 0) v = 380; else v = 240; }
    if (id == 3) { if (f == 0) v = 300; else v = 420; }
    if (id == 4) { if (f == 0) v = 620; else v = 420; }
    if (id == 5) { if (f == 0) v = 520; else v = 340; }
    if (id == 6) { if (f == 0) v = 380; else v = 260; }
    return v;
}

1A trows(1A h) {
    return (h - 120) / 14;
}

1A tcols(1A w) {
    return (w - 68) / 8;
}

1A card_w(1A w) {
    return (w - 252) / 2;
}

1A card_x(1A w, 1A i) {
    return 224 + (i - (i / 2) * 2) * (card_w(w) + 14);
}

1A card_y(1A i) {
    return 112 + (i / 2) * 128;
}

1A pad_hit(1A mx, 1A my, 1A gx, 1A gy, 1A pw, 1A ph) {
    1A col = 0;
    1A row = 0;
    if (mx < gx || my < gy) return -1;
    col = (mx - gx) / pw;
    row = (my - gy) / ph;
    if (col > 3 || row > 3) return -1;
    if (inside(mx, my, gx + col * pw, gy + row * ph, pw - 8, ph - 8) == 0) return -1;
    return row * 4 + col;
}

// 2000000000 means "error" (overflow or divide by zero)
1A apply(1A a, 1A b, 1A o) {
    1A r = a;
    1A ab = a;
    1A bb = b;
    if (ab < 0) ab = 0 - ab;
    if (bb < 0) bb = 0 - bb;
    if (o == 1) r = a + b;
    if (o == 2) r = a - b;
    if (o == 3) {
        if (ab > 0) {
            if (bb > 99999999 / ab) return 2000000000;
        }
        r = a * b;
    }
    if (o == 4) {
        if (b == 0) return 2000000000;
        r = a / b;
    }
    if (r > 99999999 || r < 0 - 99999999) return 2000000000;
    return r;
}

// ---------- window chrome ----------
// k: 0 normal, 2 maximized, 3 fullscreen
0A chrome(1A theme, 1A x, 1A y, 1A w, 1A h, str title, 1A act, 1A k) {
    str t2 = title;
    1A mx = nw::mouse_x();
    1A my = nw::mouse_y();
    1A c = accent(theme);
    1A bx = 0;
    1A by = y + 8;
    1A gx = 0;
    1A gy = 0;
    if (act == 0) c = 0x0090AEC2;
    if (k == 0) {
        nw::glass(x + 1, y + 7, w + 4, h + 9, 14, 0x0006223B, 30);
        nw::glass(x - 1, y - 1, w + 2, h + 2, 11, 0x00FFFFFF, 200);
        nw::glass(x, y, w, h, 10, c, 215);
        nw::glass(x + 1, y + 1, w - 2, 20, 9, 0x00FFFFFF, 115);
    } else {
        nw::gradient(x, y, w, h, c, c);
        nw::glass(x, y, w, 22, 0, 0x00FFFFFF, 110);
    }
    call tx(x + 18, y + 15, 0x00FFFFFF, t2);
    nw::rgrad(x + 7, y + 37, w - 14, h - 44, 5, 0x005C97BE, 0x005C97BE);
    nw::rgrad(x + 8, y + 38, w - 16, h - 46, 4, 0x00FBFEFF, 0x00E4F3FC);

    // fullscreen
    bx = x + w - 128;
    call gbtn(bx, by, 26, 22, 6, inside(mx, my, bx, by, 26, 22));
    gx = bx + 7;
    gy = by + 6;
    nw::rect(gx, gy, 4, 1, 0x00FFFFFF);
    nw::rect(gx, gy, 1, 4, 0x00FFFFFF);
    nw::rect(gx + 8, gy, 4, 1, 0x00FFFFFF);
    nw::rect(gx + 11, gy, 1, 4, 0x00FFFFFF);
    nw::rect(gx, gy + 9, 4, 1, 0x00FFFFFF);
    nw::rect(gx, gy + 6, 1, 4, 0x00FFFFFF);
    nw::rect(gx + 8, gy + 9, 4, 1, 0x00FFFFFF);
    nw::rect(gx + 11, gy + 6, 1, 4, 0x00FFFFFF);
    // minimize
    bx = x + w - 98;
    call gbtn(bx, by, 26, 22, 6, inside(mx, my, bx, by, 26, 22));
    nw::rect(bx + 8, by + 13, 10, 2, 0x00FFFFFF);
    // maximize / restore
    bx = x + w - 68;
    call gbtn(bx, by, 26, 22, 6, inside(mx, my, bx, by, 26, 22));
    if (k == 2) {
        nw::rect(bx + 10, by + 5, 8, 2, 0x00FFFFFF);
        nw::rect(bx + 16, by + 5, 2, 7, 0x00FFFFFF);
        nw::rect(bx + 8, by + 9, 8, 2, 0x00FFFFFF);
        nw::rect(bx + 8, by + 9, 2, 6, 0x00FFFFFF);
        nw::rect(bx + 14, by + 9, 2, 6, 0x00FFFFFF);
        nw::rect(bx + 8, by + 13, 8, 2, 0x00FFFFFF);
    } else {
        nw::rect(bx + 8, by + 6, 10, 2, 0x00FFFFFF);
        nw::rect(bx + 8, by + 6, 2, 10, 0x00FFFFFF);
        nw::rect(bx + 16, by + 6, 2, 10, 0x00FFFFFF);
        nw::rect(bx + 8, by + 14, 10, 2, 0x00FFFFFF);
    }
    // close
    bx = x + w - 38;
    call gbtn(bx, by, 26, 22, 5, inside(mx, my, bx, by, 26, 22));
    call tx(bx + 9, by + 7, 0x00FFFFFF, "X");
}

// ---------- desktop ----------
0A dicon(1A k, 1A x, 1A y, 1A lw, 1A c, str label) {
    str l2 = label;
    if (inside(nw::mouse_x(), nw::mouse_y(), x - 8, y - 6, 76, 84) == 1) {
        nw::glass(x - 8, y - 6, 76, 84, 8, 0x00FFFFFF, 70);
        nw::rect(x - 8, y - 6, 76, 1, 0x00D8F2FF);
    }
    call icon(k, x + 8, y, 40, c);
    call tx(x + 28 - lw * 4, y + 50, 0x00FFFFFF, l2);
}

0A desk(1A theme) {
    1A c = accent(theme);
    1A mx = nw::mouse_x();
    1A my = nw::mouse_y();
    call backdrop();
    nw::wallpaper();
    call dicon(0, 24, 24, 4, c, "Term");
    call dicon(1, 24, 112, 5, c, "Files");
    call dicon(2, 24, 200, 4, c, "Edit");
    call dicon(3, 24, 288, 4, c, "Calc");
    call dicon(4, 24, 376, 8, c, "Settings");
    call dicon(5, 24, 464, 7, c, "Monitor");
    call gpanel(1030, 40, 210, 120, 12);
    call gbtn(1052, 62, 66, 44, theme, inside(mx, my, 1030, 40, 210, 120));
    call tx(1072, 80, 0x00FFFFFF, "F7");
    call tx(1136, 70, 0x00FFFFFF, "Word");
    nw::text(1136, 88, 0x00CBEBFF, "Generator");
}

// ---------- taskbar (Windows 7 style) ----------
// ts holds 2 bits per app: 0 closed, 1 open, 2 active, 3 minimized
0A taskbar(1A theme, 1A ts, 1A menu) {
    1A mx = nw::mouse_x();
    1A my = nw::mouse_y();
    1A c = accent(theme);
    1A i = 0;
    1A p = 1;
    1A st = 0;
    1A bx = 0;
    1A hot = 0;
    nw::gradient(0, 680, 1280, 40, 0x002A5F8C, 0x000B2540);
    nw::glass(0, 680, 1280, 18, 0, 0x00FFFFFF, 52);
    nw::rect(0, 680, 1280, 1, 0x00A6DCFA);
    nw::rect(0, 719, 1280, 1, 0x00051018);

    // tray
    nw::glass(1010, 685, 246, 30, 8, 0x00FFFFFF, 26);
    nw::text(1026, 696, 0x00B7E3FF, "CPU");
    nw::number(1058, 696, 0x00FFFFFF, nw::cpu_load());
    nw::text(1096, 696, 0x00B7E3FF, "RAM");
    nw::number(1128, 696, 0x00FFFFFF, nw::ram_mb());
    call clock_small(1196, 696, 0x00FFFFFF);
    // show desktop sliver
    if (inside(mx, my, 1262, 680, 18, 40) == 1) nw::glass(1262, 682, 18, 36, 0, 0x00FFFFFF, 90);
    else nw::glass(1262, 682, 18, 36, 0, 0x00FFFFFF, 34);
    nw::rect(1262, 682, 1, 36, 0x00A6DCFA);

    // applications
    while (i < 7) {
        st = (ts / p) - ((ts / p) / 4) * 4;
        p = p * 4;
        bx = 76 + i * 52;
        hot = inside(mx, my, bx, 683, 48, 36);
        if (st == 2) {
            nw::glass(bx, 683, 48, 36, 7, 0x00FFFFFF, 105);
            nw::glass(bx + 2, 685, 44, 14, 5, 0x00FFFFFF, 60);
        } else if (st == 1) {
            nw::glass(bx, 683, 48, 36, 7, 0x00FFFFFF, 55);
        } else if (st == 3) {
            nw::glass(bx, 683, 48, 36, 7, 0x00FFFFFF, 28);
        }
        if (hot == 1) nw::glass(bx, 683, 48, 36, 7, 0x00FFFFFF, 55);
        call icon(i, bx + 11, 688, 26, c);
        if (st > 0) nw::glass(bx + 8, 715, 32, 4, 1, 0x00BFEFFF, 220);
        i = i + 1;
    }

    // start orb
    if (menu == 1) nw::glass(5, 680, 58, 40, 14, 0x00FFFFFF, 80);
    else if (inside(mx, my, 5, 680, 58, 40) == 1) nw::glass(5, 680, 58, 40, 14, 0x00FFFFFF, 46);
    nw::orb(34, 699, 20, 0x0040C040);
    nw::glass(22, 682, 24, 14, 7, 0x00FFFFFF, 120);
    call tx(30, 694, 0x00FFFFFF, "N");
}

0A mrow(1A k, 1A x, 1A y, 1A c, str label) {
