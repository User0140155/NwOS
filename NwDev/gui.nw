                            calc_by = calc_top + calc_row * (calc_bh + calc_gap);

                            nw::rect(calc_bx, calc_by, calc_bw, calc_bh, 0x00E0E0E0);
                            nw::rect(calc_bx, calc_by, calc_bw, 1, 0x00FFFFFF);
                            nw::rect(calc_bx, calc_by + calc_bh - 1, calc_bw, 1, 0x00808080);
                            nw::rect(calc_bx, calc_by, 1, calc_bh, 0x00FFFFFF);
                            nw::rect(calc_bx + calc_bw - 1, calc_by, 1, calc_bh, 0x00808080);

                            if (calc_row == 0) {
                                if (calc_col == 0) nw::text(calc_bx + 24, calc_by + 11, 0x000000, "C");
                                if (calc_col == 1) nw::number(calc_bx + 26, calc_by + 11, 0x000000, 0);
                                if (calc_col == 2) nw::text(calc_bx + 26, calc_by + 11, 0x000000, "/");
                                if (calc_col == 3) nw::text(calc_bx + 26, calc_by + 11, 0x000000, "*");
                            } else if (calc_col < 3) {
                                calc_digit = 10 - calc_row * 3 + calc_col;
                                nw::number(calc_bx + 26, calc_by + 11, 0x000000, calc_digit);
                            } else {
                                if (calc_row == 1) nw::text(calc_bx + 26, calc_by + 11, 0x000000, "-");
                                if (calc_row == 2) nw::text(calc_bx + 26, calc_by + 11, 0x000000, "+");
                                if (calc_row == 3) nw::text(calc_bx + 26, calc_by + 11, 0x000000, "=");
                            }
                            calc_col = calc_col + 1;
                        }
                        calc_row = calc_row + 1;
