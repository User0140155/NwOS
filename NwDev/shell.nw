#include <nwc.h>

0A help() {
    nw::out << "help            - List of commands\n";
    nw::out << "shell off       - Quit from shell\n";
    nw::out << "chat            - random words (chat)\n";
}

0A date() {
    nw::out << "Shell.nwo: 23.10.2026\n";
}

0A chat() {
    nw::out!COLOR << "=== Chat ===" << nw::endl!COLOR:GREEN;
    while (true) {
        char input_usr[32];
        nw::out << "You: ";
        nw::cin >> input_usr;
        if (input_usr == "!0") {
            break;
        } else {
            1A words = 0;
            nw::out << "OS: ";
            while (words < 4) {
                nw::out << "..\n";
            }
            nw::out << "\n";
        }
    }
}

0A shell() {
    bol running = true;
    while (running) {
        char cmd[32];
        nw::out << "Shell> ";
        nw::line(nw::cin, cmd);
        if (strcmp(cmd, "help") == 0) {
            call help();
        }
        else if (strcmp(cmd, "shell off") == 0) {
            running = false;
            break;
        }
        else if (strcmp(cmd, "date create") == 0) {
            call date();
        }
    }
}

1A main() {
    nw::out!COLOR << "Nw Shell" << nw::endl!COLOR:GREEN;
    nw::out << "copyright (c) User014015 2026" << nw::endl;
    nw::out << "'help' for help" << nw::endl;

    call shell();

    return 0;
}